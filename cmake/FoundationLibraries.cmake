# Locked foundation libraries: profile selection, lock verification, Sc::GLib,
# sc_foundation (Amendment F item 3) and sc_parallel (spec 6, Amendment F item 2).
# Included by cmake/Foundation.cmake and, when a project module sets "foundation", by
# cmake/Project.cmake. The block below is the former head of cmake/Foundation.cmake,
# unchanged, followed by the sc_parallel target.
if(NOT TARGET sc_foundation)
# Exact profile input selection, never ambient pkg-config or global link paths.
if(NOT EXISTS "${PROJECT_SOURCE_DIR}/foundation.lock.json")
  message(FATAL_ERROR "locked foundation inputs are mandatory")
endif()
file(READ "${PROJECT_SOURCE_DIR}/foundation.lock.json" sc_lock)
string(JSON sc_state GET "${sc_lock}" status)
if(NOT sc_state STREQUAL "ARTIFACTS_QUALIFIED")
  message(FATAL_ERROR "foundation dependency artifacts are not qualified")
endif()
if(SAFETY_PROFILE STREQUAL "ordinary" OR SAFETY_PROFILE STREQUAL "strict" OR SAFETY_PROFILE STREQUAL "warnings")
  if(CMAKE_C_FLAGS MATCHES "-O2")
    set(sc_optimization O2)
  else()
    set(sc_optimization O0)
  endif()
  if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
    set(SC_DEPENDENCY_PROFILE "gcc-${sc_optimization}")
  else()
    set(SC_DEPENDENCY_PROFILE "clang-${sc_optimization}")
  endif()
elseif(SAFETY_PROFILE STREQUAL "gcc-analyzer")
  set(SC_DEPENDENCY_PROFILE gcc-O0)
elseif(SAFETY_PROFILE STREQUAL "hardened")
  set(SC_DEPENDENCY_PROFILE clang-O2)
elseif(SAFETY_PROFILE STREQUAL "integer")
  # Upstream defined unsigned operations keep UBSan; first-party integer flags
  # remain unchanged. This equivalence is explicit in the protected lock.
  set(SC_DEPENDENCY_PROFILE ubsan)
else()
  set(SC_DEPENDENCY_PROFILE "${SAFETY_PROFILE}")
endif()
set(SC_DEPENDENCY_PREFIX "/opt/foundation/${SC_DEPENDENCY_PROFILE}")
string(JSON sc_count LENGTH "${sc_lock}" profiles "${SC_DEPENDENCY_PROFILE}" files)
math(EXPR sc_last "${sc_count}-1")
foreach(sc_i RANGE ${sc_last})
  string(JSON sc_file MEMBER "${sc_lock}" profiles "${SC_DEPENDENCY_PROFILE}" files ${sc_i})
  string(JSON sc_expected GET "${sc_lock}" profiles "${SC_DEPENDENCY_PROFILE}" files "${sc_file}")
  if(NOT EXISTS "${SC_DEPENDENCY_PREFIX}/${sc_file}")
    message(FATAL_ERROR "locked dependency file missing: ${sc_file}")
  endif()
  file(SHA256 "${SC_DEPENDENCY_PREFIX}/${sc_file}" sc_actual)
  if(NOT sc_actual STREQUAL sc_expected)
    message(FATAL_ERROR "locked dependency file substituted: ${sc_file}")
  endif()
endforeach()
add_library(ScGLib SHARED IMPORTED GLOBAL)
set_target_properties(ScGLib PROPERTIES
  IMPORTED_LOCATION "${SC_DEPENDENCY_PREFIX}/lib/libglib-2.0.so"
  IMPORTED_SONAME libglib-2.0.so.0
  INTERFACE_INCLUDE_DIRECTORIES "${SC_DEPENDENCY_PREFIX}/include/glib-2.0;${SC_DEPENDENCY_PREFIX}/lib/glib-2.0/include"
  INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${SC_DEPENDENCY_PREFIX}/include/glib-2.0;${SC_DEPENDENCY_PREFIX}/lib/glib-2.0/include"
  INTERFACE_COMPILE_DEFINITIONS "GLIB_VERSION_MIN_REQUIRED=GLIB_VERSION_2_70;GLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_70")
add_library(Sc::GLib ALIAS ScGLib)
set(FOUNDATION_MUTANT "NONE" CACHE STRING "Protected test-only foundation mutation")
set(sc_foundation_source "${PROJECT_SOURCE_DIR}/foundation/src/sc-foundation.c")
if(NOT FOUNDATION_MUTANT STREQUAL "NONE")
  file(READ "${PROJECT_SOURCE_DIR}/safety/foundation-mutants.json" sc_mutants)
  string(JSON sc_mutant_case ERROR_VARIABLE sc_mutant_error GET "${sc_mutants}" mutants "${FOUNDATION_MUTANT}" case_id)
  if(sc_mutant_error)
    message(FATAL_ERROR "uninventoried foundation mutation")
  endif()
  string(JSON sc_mutant_recipe GET "${sc_mutants}" recipe)
  string(JSON sc_mutant_expected GET "${sc_mutants}" recipe_sha256)
  file(SHA256 "${PROJECT_SOURCE_DIR}/${sc_mutant_recipe}" sc_mutant_actual)
  if(NOT sc_mutant_actual STREQUAL sc_mutant_expected)
    message(FATAL_ERROR "foundation mutation recipe changed")
  endif()
  execute_process(COMMAND python3 "${PROJECT_SOURCE_DIR}/${sc_mutant_recipe}" "${FOUNDATION_MUTANT}" "${CMAKE_BINARY_DIR}/foundation-mutation"
    RESULT_VARIABLE sc_generated OUTPUT_FILE "${CMAKE_BINARY_DIR}/mutation-generation.log" ERROR_FILE "${CMAKE_BINARY_DIR}/mutation-generation-errors.log" TIMEOUT 10)
  if(NOT sc_generated EQUAL 0)
    message(FATAL_ERROR "foundation mutation generation blocked")
  endif()
  set(sc_foundation_source "${CMAKE_BINARY_DIR}/foundation-mutation/sc-foundation-mutant.c")
endif()
add_library(sc_foundation STATIC "${sc_foundation_source}")
safety_target(sc_foundation)
target_include_directories(sc_foundation PUBLIC "${PROJECT_SOURCE_DIR}/foundation/include")
target_link_libraries(sc_foundation PUBLIC Sc::GLib)
set(FOUNDATION_DISABLED_GUARDS "" CACHE STRING "Explicit qualification of first-party guard macros")
foreach(sc_definition IN LISTS FOUNDATION_DISABLED_GUARDS)
  if(NOT sc_definition MATCHES "^(NDEBUG|G_DISABLE_ASSERT|G_DISABLE_CHECKS)$")
    message(FATAL_ERROR "unapproved foundation macro variant")
  endif()
  target_compile_definitions(sc_foundation PRIVATE "${sc_definition}")
endforeach()
# Narrow GLib batch adapter (spec 6, Amendment F item 2): first-party, same flags as sc_foundation.
set(sc_parallel_source "${PROJECT_SOURCE_DIR}/foundation/parallel/sc-parallel.c")
set(PARALLEL_MUTANT "NONE" CACHE STRING "Protected test-only sc_parallel mutation")
if(NOT PARALLEL_MUTANT STREQUAL "NONE")
  file(READ "${PROJECT_SOURCE_DIR}/safety/parallel-mutants.json" sc_pmutants)
  string(JSON sc_pmutant_lane ERROR_VARIABLE sc_pmutant_error GET "${sc_pmutants}" mutants "${PARALLEL_MUTANT}" lane)
  if(sc_pmutant_error)
    message(FATAL_ERROR "uninventoried sc_parallel mutation")
  endif()
  string(JSON sc_pmutant_recipe GET "${sc_pmutants}" recipe)
  string(JSON sc_pmutant_expected GET "${sc_pmutants}" recipe_sha256)
  file(SHA256 "${PROJECT_SOURCE_DIR}/${sc_pmutant_recipe}" sc_pmutant_actual)
  if(NOT sc_pmutant_actual STREQUAL sc_pmutant_expected)
    message(FATAL_ERROR "sc_parallel mutation recipe changed")
  endif()
  execute_process(COMMAND python3 "${PROJECT_SOURCE_DIR}/${sc_pmutant_recipe}" "${PARALLEL_MUTANT}" "${CMAKE_BINARY_DIR}/parallel-mutation"
    RESULT_VARIABLE sc_pgenerated OUTPUT_FILE "${CMAKE_BINARY_DIR}/parallel-mutation-generation.log" ERROR_FILE "${CMAKE_BINARY_DIR}/parallel-mutation-generation-errors.log" TIMEOUT 10)
  if(NOT sc_pgenerated EQUAL 0)
    message(FATAL_ERROR "sc_parallel mutation generation blocked")
  endif()
  set(sc_parallel_source "${CMAKE_BINARY_DIR}/parallel-mutation/sc-parallel-mutant.c")
endif()
add_library(sc_parallel STATIC "${sc_parallel_source}")
safety_target(sc_parallel)
target_include_directories(sc_parallel PUBLIC "${PROJECT_SOURCE_DIR}/foundation/parallel")
target_link_libraries(sc_parallel PUBLIC Sc::GLib)
endif()
