{
  "schema_version": 1,
  "gates": [
    "format",
    "gcc-O0",
    "gcc-O2",
    "clang-O0",
    "clang-O2",
    "hardened",
    "tidy",
    "csa",
    "gcc-analyzer",
    "ast",
    "asan",
    "ubsan",
    "integer",
    "msan",
    "tsan",
    "unit",
    "integration",
    "coverage",
    "fuzz-replay",
    "fuzz-exploration",
    "clusterfuzzlite",
    "inventory",
    "review-protocol"
  ],
  "fuzz_seconds": 30,
  "coverage_source": "safety/contract.json",
  "forbidden_text": [
    "#pragma GCC diagnostic",
    "#pragma clang diagnostic",
    "_Pragma",
    "__has_feature",
    "__has_extension",
    "no_sanitize",
    "no_address_safety_analysis",
    "disable_sanitizer_instrumentation",
    "no_profile_instrument_function",
    "no_instrument_function",
    "no_stack_protector",
    "optnone",
    "__attribute__((optimize",
    "sanitize-ignorelist",
    "sanitize-blacklist",
    "__SANITIZE_",
    "NOLINT",
    "##",
    "%:%:",
    "__OPTIMIZE__",
    "__OPTIMIZE_SIZE__",
    "__NO_INLINE__",
    "__clang",
    "__GNUC",
    "__llvm__",
    "__INTEL_COMPILER",
    "_MSC_VER",
    "__COVERAGE__",
    "__has_builtin",
    "__has_attribute",
    "__has_c_attribute",
    "__has_include",
    "__has_cpp_attribute",
    "_FORTIFY_SOURCE",
    "__USE_FORTIFY_LEVEL",
    "__SSP",
    "__PIE__",
    "__pie__",
    "__PIC__",
    "__pic__",
    "__asan_",
    "__lsan_",
    "__msan_",
    "__tsan_",
    "__ubsan_",
    "__hwasan_",
    "__dfsan_",
    "__sanitizer_",
    "__llvm_profile",
    "__gcov"
  ],
  "forbidden_patterns": [
    "(#|%:|\\?\\?=)\\s*pragma\\b(?!\\s+once\\b)",
    "\\?\\?[=/'()!<>-]",
    "optimize_*\\s*\\("
  ]
}
