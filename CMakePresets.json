{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-O0",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-O0",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "SAFETY_PROFILE": "strict",
        "CMAKE_C_FLAGS": "-O0",
        "SAFETY_VARIANT": "good"
      }
    },
    {
      "name": "gcc-O2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-O2",
