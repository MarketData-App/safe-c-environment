{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_identity",
    "source_files",
    "source_bytes",
    "profile",
    "image_id",
    "compatibility",
    "operation",
    "request",
    "test",
    "binary",
    "ctest",
    "argv",
    "environment",
    "cwd",
    "observed",
    "finding_id",
    "evidence_paths",
    "original_replay_available",
    "reason",
    "demo_files",
    "fuzz_job"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2048,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes",
          "executable"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "profile": {
      "type": "string"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "operation": {
      "enum": [
        "test",
        "build",
        "replay",
        "debug",
        "prepare",
        "doctor",
        "nav",
        "targets",
        "tests"
      ]
    },
    "request": {
      "type": "object"
    },
    "test": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "target",
            "command",
            "labels",
            "association"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "association": {
              "const": "actual CTest executable command"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "binary": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ctest": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "argv": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cwd": {
      "const": "/work"
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "failure"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "finding_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^DEV-RUN-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_paths": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string"
      }
    },
    "original_replay_available": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "demo_files": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes",
          "executable"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "fuzz_job": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variant",
            "input",
            "input_sha256",
            "budget_runs",
            "minimized_input"
          ],
          "properties": {
            "variant": {
              "enum": [
                "bad",
                "good"
              ]
            },
            "input": {
              "const": "fuzz/regressions/C32"
            },
            "input_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "budget_runs": {
              "const": 1
            },
            "minimized_input": {
              "const": false
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
