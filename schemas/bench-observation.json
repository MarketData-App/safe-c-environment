{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "if":{"required":["scope"],"properties":{"scope":{"const":"capacity"}}},"then":{"required":["capacity"]},
 "allOf":[{"description":"N4-A03: only a C row (c-serial, c-threads) may record the native pool shape; every other row records the Python pool shape or null (so check_concurrency_identity never reads a native pool as a Python pool). C1: every document valid before Task 19 stays valid; only the native shape on a non-C row, which Task 19 opened, is refused.",
   "if":{"required":["variant"],"properties":{"variant":{"not":{"enum":["c-serial","c-threads"]}}}},"then":{"properties":{"pool":{"type":["object","null"],"required":["max_pending"]}}}}],
 "required":["schema_version","run_id","trial_id","block","order","point","scope","mode","variant","workers","tier","phase","warmup","runner","wall_ns",
  "cpu_usage_usec","cpu_user_usec","cpu_system_usec","nr_throttled","throttled_usec","pids_start","pids_end","threads_start","threads_end",
  "loops","work_units","phases","result_sha256","eligible","verdict","memory","unavailable"],
 "$defs":{"count":{"type":["integer","null"],"minimum":0},"hex":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"}},
 "properties":{
  "schema_version":{"const":1},"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"trial_id":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},
  "block":{"type":["integer","null"],"minimum":0},"order":{"type":["integer","null"],"minimum":0},"point":{"type":"string","pattern":"^[a-z0-9-]{3,48}$"},
  "scope":{"enum":["kernel","caller","control","memory","capacity"]},"mode":{"enum":["warm","cold","direct","control"]},
  "variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads","control"]},
  "workers":{"enum":["direct",1,2,4]},"tier":{"enum":["tiny","small","medium","large","none"]},
  "phase":{"enum":["work","caller","import","pool_start","teardown","control-zero","control","ready","post-work","capacity"]},
  "warmup":{"type":"boolean"},"runner":{"enum":["pyperf","safe-c-trial-runner"]},
  "wall_ns":{"type":"integer","minimum":0},"cpu_usage_usec":{"$ref":"#/$defs/count"},"cpu_user_usec":{"$ref":"#/$defs/count"},"cpu_system_usec":{"$ref":"#/$defs/count"},
  "nr_throttled":{"$ref":"#/$defs/count"},"throttled_usec":{"$ref":"#/$defs/count"},"pids_start":{"$ref":"#/$defs/count"},"pids_end":{"$ref":"#/$defs/count"},
  "threads_start":{"$ref":"#/$defs/count"},"threads_end":{"$ref":"#/$defs/count"},"loops":{"type":"integer","minimum":0},"work_units":{"$ref":"#/$defs/count"},
  "phases":{"type":"object","additionalProperties":false,"properties":{"prepare":{"$ref":"#/$defs/count"},"pool_start":{"$ref":"#/$defs/count"},"work":{"$ref":"#/$defs/count"},"materialize":{"$ref":"#/$defs/count"},"transport":{"$ref":"#/$defs/count"}}},
  "result_sha256":{"$ref":"#/$defs/hex"},"eligible":{"type":["boolean","null"]},
  "verdict":{"type":"object","additionalProperties":false,"required":["failures"],"properties":{"failures":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
   "verdict_counts":{"type":"object","maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},"additionalProperties":{"type":"integer","minimum":0},"description":"FR5: the project's named verdict counts; each name is a name of the protocol verdict_counts list (bench run refuses another name)"},"model_errors":{"type":"integer","minimum":0},"reduction":{"enum":["MATCH","MISMATCH","ROW_COUNT","MISSING_ROWS","NOT_RUN"]}}},
  "memory":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,
   "required":["ready_current","ready_anon","ready_file","ready_shmem","retained_current","retained_anon","retained_file","retained_shmem","group_peak_bytes","group_peak_source","sampled"],
   "properties":{"ready_current":{"$ref":"#/$defs/count"},"ready_anon":{"$ref":"#/$defs/count"},"ready_file":{"$ref":"#/$defs/count"},"ready_shmem":{"$ref":"#/$defs/count"},
    "retained_current":{"$ref":"#/$defs/count"},"retained_anon":{"$ref":"#/$defs/count"},"retained_file":{"$ref":"#/$defs/count"},"retained_shmem":{"$ref":"#/$defs/count"},
    "group_peak_bytes":{"$ref":"#/$defs/count"},"group_peak_source":{"const":"host memory.peak, trial container lifetime"},
    "largest_waited_child_rss_kib":{"$ref":"#/$defs/count"},"summed_rss_upper_bound_kib":{"$ref":"#/$defs/count"},
    "sampled":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["label","max_bytes","interval_ms"],
     "properties":{"label":{"const":"sampled lower bound"},"max_bytes":{"type":"integer","minimum":0},"interval_ms":{"type":"integer","minimum":1}}}]}}}]},
  "cpu_pressure_total":{"$ref":"#/$defs/count"},"memory_pressure_total":{"$ref":"#/$defs/count"},"pids_peak":{"$ref":"#/$defs/count"},
  "pyperf_wall_ns":{"type":["integer","null"],"minimum":0},
  "pool":{"anyOf":[{"description":"Phase 2 Task 19 (FR6 N4): the pool evidence of a c-threads row (benchlab.trial native_fields): the one-per-worker chunk rule, its chunk sizes and chunk times.","type":"object","additionalProperties":false,"required":["chunk_rule","chunks","chunk_sizes","chunk_wall_ns"],"properties":{"chunk_rule":{"const":"one-per-worker"},"chunks":{"type":"integer","minimum":0},"chunk_sizes":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"integer","minimum":1}},"chunk_wall_ns":{"type":"array","maxItems":8,"items":{"type":"integer","minimum":0}}}},
   {"type":["object","null"],"additionalProperties":false,"required":["max_pending","chunks","window","pids_distinct","caller_pid_included","threads","start_method","chunk_rule","chunk_sizes","chunk_wall_ns"],
   "properties":{"max_pending":{"type":"integer","minimum":0},"chunks":{"type":"integer","minimum":0},"window":{"type":"integer","minimum":0},"pids_distinct":{"type":"integer","minimum":0},
    "caller_pid_included":{"type":"boolean"},"threads":{"type":"integer","minimum":0},"start_method":{"enum":["thread","spawn"]},"tracker_session_setup":{"type":["boolean","null"]},
    "chunk_rule":{"const":"one-per-worker"},"chunk_sizes":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"integer","minimum":1}},
    "chunk_wall_ns":{"type":"array","maxItems":8,"items":{"type":"integer","minimum":0}}}}]},
  "unavailable":{"type":"object","additionalProperties":{"type":"string","maxLength":80}},
  "selector":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},"unit":{"type":"string","pattern":"^[a-z0-9-]{1,16}/[a-z-]{3,24}$"},"dataset_ref":{"type":"string","pattern":"^[a-z0-9:#-]{3,64}$"},
  "failure_reason":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"},
  "panel_walls":{"description":"Base Task 18 (G7.3), fix round 1 (T18-C1b): the audit sample of a single-record panel trial, per panel record the first at most 64 per-call walls in ns in call order (all walls when L <= 64). Never a decision input.",
   "type":"object","maxProperties":6,"propertyNames":{"pattern":"^[a-z0-9-]{1,32}$"},
   "additionalProperties":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"integer","minimum":0}}},
  "panel_passes":{"description":"T18-C1b: L, the passes of the panel trial (bounded by bench_plan.PANEL_MAX_PASSES = 8192; bench plan refuses more: l-pass-over-bound).",
   "type":"integer","minimum":1,"maximum":8192},
  "panel_stats":{"description":"T18-C1b (G7.3 item 3): per panel record the exact median, min and max of its L per-call walls in ns, computed in the container. The trial value is the largest of the medians.",
   "type":"object","maxProperties":6,"propertyNames":{"pattern":"^[a-z0-9-]{1,32}$"},
   "additionalProperties":{"type":"object","additionalProperties":false,"required":["median_ns","min_ns","max_ns"],
    "properties":{"median_ns":{"type":"number","minimum":0},"min_ns":{"type":"integer","minimum":0},"max_ns":{"type":"integer","minimum":0}}}},
  "panel_call_ns":{"description":"T18-APP-03: the achieved panel trial wall in ns, the sum of the 6 x L timed calls, computed in the container. The unit diagnostics flag a warm trial below the 0.5 s target of G7.3; never a decision input.",
   "type":"integer","minimum":0},
  "panel_status_diff":{"description":"Base Task 18 (H21.4): panel rows whose status differs from the panel reference status (no band acceptance).",
   "type":"array","maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["cell","model","status","reference_status","band_difference"],
    "properties":{"cell":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"},"model":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},
     "status":{"type":["string","null"],"maxLength":32},"reference_status":{"type":"string","maxLength":32},"band_difference":{"type":["boolean","null"]}}}},
  "detail":{"enum":["panel-status",null]},
  "route":{"description":"Phase 2 Task 19 (FR6 N4): the data transfer route of a C caller row; null (or absent) for every Python row, every kernel row and every Phase 1 run.","enum":[null,"stdio","shm","inproc"]},
  "route_label":{"description":"The policy text of the route (safety/performance-policy.json routes).","type":["string","null"],"maxLength":300},
  "copied_bytes":{"description":"Bytes copied over the route during the timed call (frames on pipes, or the region copy-in and copy-out).","type":["integer","null"],"minimum":0},
  "load_process":{"description":"The process that loaded the in-process library (inproc rows).","oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["pid","role"],"properties":{"pid":{"type":"integer","minimum":1},"role":{"const":"caller"}}}]},
  "self_timing":{"description":"The C kernel self-timing of its timed loops (kernel C rows; PLK1 mono_ns and cpu_ns).","oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["mono_ns","cpu_ns"],"properties":{"mono_ns":{"type":"integer","minimum":0},"cpu_ns":{"type":"integer","minimum":0}}}]},
  "native_sha256":{"description":"The sha256 of the native binary that ran (kernel C rows).","$ref":"#/$defs/hex"},
  "capacity":{"description":"Task 22 (Amendment H6): the note of one capacity trial (closed loop; exploratory, never decides).",
   "type":"object","additionalProperties":false,"required":["configuration","clients","servers","requests_per_client","completed","errors","latencies_ns","route"],
   "properties":{"configuration":{"enum":["serial-workers","threaded-worker","python-pool"]},"clients":{"type":"integer","minimum":1,"maximum":4},
    "servers":{"type":"integer","minimum":1,"maximum":4},"requests_per_client":{"type":"integer","minimum":1,"maximum":64},"completed":{"type":"integer","minimum":0},
    "errors":{"type":"integer","minimum":0},"latencies_ns":{"type":"array","maxItems":4096,"items":{"type":"integer","minimum":0}},
    "route":{"type":["string","null"],"pattern":"^[a-z0-9-]{1,16}$"}}}
 },
 "dependentRequired":{"panel_walls":["panel_passes","panel_stats","panel_call_ns"],"panel_stats":["panel_passes","panel_walls","panel_call_ns"],"panel_passes":["panel_stats","panel_walls","panel_call_ns"],
  "panel_call_ns":["panel_passes","panel_stats","panel_walls"]}}
