{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_identity": {
      "type": "string"
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "source_identity": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "reproducer": {
            "type": "string"
          },
          "state": {
            "enum": [
              "OPEN",
              "UNRESOLVED",
              "VERIFIED",
              "REJECTED",
              "DUPLICATE",
              "BLOCKED"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "history": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attempt",
                    "before_failed",
                    "after_passed",
                    "regression_identity",
                    "source_identity"
                  ],
                  "properties": {
                    "attempt": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "before_failed": {
                      "type": "boolean"
                    },
                    "after_passed": {
                      "type": "boolean"
                    },
                    "regression_identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_identity": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reason",
                    "duplicate_of"
                  ],
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "duplicate_of": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "verification": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempt",
                  "before_failed",
                  "after_passed",
                  "regression_identity",
                  "source_identity"
                ],
                "properties": {
                  "attempt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "before_failed": {
                    "type": "boolean"
                  },
                  "after_passed": {
                    "type": "boolean"
                  },
                  "regression_identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_identity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "origin",
          "source_identity",
          "location",
          "property",
          "severity",
          "rationale",
          "reproducer",
          "state",
          "attempts",
          "history",
          "verification"
        ]
      }
    },
    "review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "unit",
          "question",
          "locations"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_identity",
    "units",
    "findings",
    "review"
  ]
}
