{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assembly_recipe",
    "assembly_recipe_sha256",
    "base_image_id",
    "extraction_recipe",
    "extraction_recipe_sha256",
    "foundation_lock_sha256",
    "image_id",
    "image_registry_digest",
    "independent_approval",
    "inherited_project_qualification",
    "inputs",
    "license_review",
    "notices",
    "ordinary_image_migrated",
    "owner",
    "packages",
    "payload_chunks",
    "payload_manifest",
    "sanitizer_boundary",
    "schema_version",
    "status",
    "toolchain_lock_sha256",
    "tools",
    "upstream_signers"
  ],
  "properties": {
    "assembly_recipe": {
      "const": "tools/assemble_developer_image.py"
    },
    "assembly_recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extraction_recipe": {
      "const": "container/developer-package.py"
    },
    "extraction_recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "foundation_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image_registry_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "independent_approval": {
      "type": "string"
    },
    "inherited_project_qualification": {
      "const": false
    },
    "inputs": {
      "type": "array",
      "minItems": 41,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^third_party/developer/[A-Za-z0-9_./+~:-]+$"
          },
          "kind": {
            "enum": [
              "signed-metadata",
              "provenance-data",
              "binary-package",
              "development-payload",
              "payload-manifest"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "license_review": {
      "type": "string"
    },
    "notices": {
      "type": "object"
    },
    "ordinary_image_migrated": {
      "const": false
    },
    "owner": {
      "type": "string"
    },
    "packages": {
      "type": "array"
    },
    "payload_chunks": {
      "type": "array"
    },
    "payload_manifest": {
      "type": "string"
    },
    "sanitizer_boundary": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "ACQUIRED_UNQUALIFIED"
    },
    "toolchain_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gdb",
        "clangd"
      ],
      "properties": {
        "clangd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "version",
            "version_exit_code"
          ],
          "properties": {
            "path": {
              "const": "/usr/lib/llvm-19/bin/clangd"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "version_exit_code": {
              "const": 0
            }
          }
        },
        "gdb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "version",
            "version_exit_code"
          ],
          "properties": {
            "path": {
              "const": "/usr/bin/gdb"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "version_exit_code": {
              "const": 0
            }
          }
        }
      }
    },
    "upstream_signers": {
      "type": "array"
    }
  }
}
