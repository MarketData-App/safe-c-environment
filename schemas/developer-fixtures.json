    "pipeline_subcases": [
      {
        "parent": "P01",
        "name": "dev-tool-or-route-unavailable",
        "variants": [
          "clangd",
          "gdb",
          "adapter",
          "tracing",
          "host-route"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P02",
        "name": "dev-build-context-mismatch",
        "variants": [
          "compilation-database",
          "generated-header",
          "symbols",
          "binary",
          "loaded-dependency"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P04",
        "name": "dev-config-or-debugger-injection",
        "variants": [
          "query-driver",
          "config",
          "plugin",
          "startup-script",
          "arbitrary-gdb-command",
          "shell-argv",
          "remote-target",
          "external-pid",
          "profile-override"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P07",
        "name": "dev-inventory-or-partial-success",
        "variants": [
          "missing-case",
          "missing-control",
          "zero-tests",
          "partial-index-as-acceptance"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P10",
        "name": "dev-stale-state",
        "variants": [
          "worktree",
          "profile-index",
          "cache-artifact",
          "failure-bundle",
          "source-symbol-map",
          "parent-report"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P11",
        "name": "dev-failure-masked",
        "variants": [
          "zero-gdb-after-inferior-failure",
          "unreached-breakpoint",
          "inferior-mi-spoof",
          "replay-child-status",
          "truncation",
          "incomplete-timeout-cleanup"
        ],
        "control": "unmodified permitted command/evidence"
      },
      {
        "parent": "P15",
        "name": "dev-policy-or-packaging-downgrade",
        "variants": [
          "limits",
          "tracing",
          "auto-load",
          "acceptance-cache",
          "runtime-payload"
        ],
        "control": "unmodified permitted command/evidence"
      }
    ],
    "live_trial_is_separate": true
  }
