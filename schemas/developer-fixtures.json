          "resolved-reached-source-stop",
          "predetermined-values",
          "source-step",
          "wrong-symbols",
          "unreached-stop"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E09",
        "name": "signals-threads-and-outcomes",
        "subchecks": [
          "signal-stop",
          "multiple-thread-stacks",
          "normal-exit",
          "nonzero-exit",
          "signal-termination",
          "debugger-failure",
          "timeout",
          "inferior-protocol-spoof"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E10",
        "name": "controlled-debugger-startup",
        "subchecks": [
          "startup-canaries",
          "auto-load-disabled",
          "local-thread-library",
          "aslr-preserved",
          "literal-argv",
          "prohibited-command-target",
