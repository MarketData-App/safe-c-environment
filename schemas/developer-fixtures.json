        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E11",
        "name": "bounded-session-lifecycle",
        "subchecks": [
          "single-profile-admission",
          "repeat-cleanup",
          "cancellation",
          "timeout",
          "restart",
          "output-overflow",
          "foreign-scope-rejection"
