        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E12",
        "name": "workflow-and-portability",
        "subchecks": [
          "public-command-rehearsal",
          "two-exports",
          "fresh-child-combined",
          "no-grandchildren",
          "portable-payload",
          "runtime-exclusion"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      }
