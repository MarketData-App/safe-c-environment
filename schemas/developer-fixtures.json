{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "const": {
    "schema_version": 1,
    "status": "CANDIDATE_UNSEALED",
    "cases": [
      {
        "id": "E01",
        "name": "tools-and-preparation",
        "subchecks": [
          "entrypoint",
          "idempotent-offline-prepare",
          "missing-tool-input",
          "unknown-selection"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E02",
        "name": "real-compilation-context",
        "subchecks": [
          "registered-tu",
          "public-header-including-tu",
          "generated-glib-header",
          "wrong-missing-stale-context"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E03",
        "name": "semantic-operations",
        "subchecks": [
          "definition-declaration",
          "cross-file-references",
          "comment-string-decoys",
          "distinct-static-symbols",
          "api-glib-hover",
          "symbols",
          "diagnostic-edit-repair"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E04",
        "name": "freshness-and-coordinates",
        "subchecks": [
          "source-edit",
          "rename-delete",
          "new-registered-file",
          "generated-header-edit",
          "profile-switch",
          "unicode-scalar-position",
          "spaces-path",
          "different-worktree"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E05",
        "name": "targeted-test-and-coverage",
        "subchecks": [
          "actual-discovered-test",
          "failing-control",
          "unknown-empty-test",
          "matching-coverage",
          "stale-coverage-rejected",
          "partial-scope"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E06",
        "name": "incremental-correctness",
        "subchecks": [
          "cold-build",
          "warm-no-change",
          "source-edit",
          "public-header-edit",
          "generated-header-edit",
          "define-change",
          "profile-switch",
          "rebuilt-object-identities",
          "optional-cache-absent"
        ],
        "control": "matching permitted operation under identical relevant inputs"
      },
      {
        "id": "E07",
        "name": "failure-bundle-and-replay",
        "subchecks": [
          "real-test-failure",
          "fuzz-regression",
          "original-input-replay",
