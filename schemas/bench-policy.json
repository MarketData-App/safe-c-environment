{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"The protected framework performance policy (safety/performance-policy.json). FR3 (FS1 F5, design Task 32): it holds only framework values. Agreement tolerances, solver constants, planning shares per selector, required before_run checks and unit-threshold decision policies are project data in the project's protected protocol file (schemas/bench-protocol.json); bench_model.load_policy(root, project) adds them for that project.",
 "required":["schema_version","policy_version","envelope","job_deadlines","budgets","trials","sizes","pools","protocol","statistics","local","pyperf","controls","resolution","effects","coverage","accounting","capacity","decision_policies"],
 "properties":{
  "schema_version":{"const":1},
  "policy_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+(-provisional)?$"},
  "envelope":{"type":"object","additionalProperties":false,"required":["cpus","reduced_cpus","minimum_multicore_cpus","memory_bytes","pids","thread_environment"],
   "properties":{"cpus":{"const":4},"reduced_cpus":{"const":2},"minimum_multicore_cpus":{"const":2},"memory_bytes":{"const":2147483648},"pids":{"const":256},
    "thread_environment":{"const":{"OPENBLAS_NUM_THREADS":"1","OMP_NUM_THREADS":"1","MKL_NUM_THREADS":"1"}}}},
  "job_deadlines":{"type":"object","additionalProperties":false,"required":["smoke","session","memory","doctor","selftest","long_check","control"],
   "description":"long_check: the deadline of `bench check --long` (a long project check, for example a project's data generation).",
   "properties":{"smoke":{"const":600},"session":{"const":10800},"memory":{"const":600},"doctor":{"const":120},"selftest":{"const":3000},"long_check":{"const":10800},"control":{"const":120}}},
  "budgets":{"type":"object","additionalProperties":false,"required":["decision_cap_seconds","session_cap_seconds","estimate_seconds_per_record","trial_overhead_seconds","raw_evidence_job_bytes","raw_evidence_run_bytes"],
   "properties":{"decision_cap_seconds":{"const":28800},"session_cap_seconds":{"const":10800},
    "estimate_seconds_per_record":{"const":{"py-reference":0.140,"py-optimized":0.0045,"py-library":0.005,"c":0.0004}},
    "trial_overhead_seconds":{"const":2.0},"raw_evidence_job_bytes":{"const":33554432},"raw_evidence_run_bytes":{"const":268435456}}},
  "trials":{"const":{"primary":12,"secondary":6,"exploratory":[1,3],"smoke_blocks":2,"memory_primary":5,"memory_exploratory":1,"smoke_memory":1,"warmups_per_variant_per_session":1}},
  "sizes":{"const":{"tiny":1,"small":256,"medium":1024,"large":13230}},
  "pools":{"const":{"workers":[1,2,4],"chunk_rule":"one-per-worker","request_limit":14336,"window_per_worker":2,"start_method":"spawn"}},
  "protocol":{"const":{"max_request_records":14336,"max_frame_bytes":4194304,"kernel_buffer_records":20000,"max_input_records":20000,"max_input_bytes":33554432}},
  "statistics":{"const":{"bootstrap_resamples":10000,"bootstrap_seed":20261007,"interval":0.95}},
  "local":{"const":{"aggregate_max_bytes":262144,"max_input_bytes":33554432}},
  "pyperf":{"const":{"agreement_abs_ns":1000000,"agreement_rel":0.02}},
  "controls":{"type":"object","additionalProperties":false,
   "description":"Ruling T10-C2: a closed object; every Phase 1 key keeps its const value; aa_pressure is the Amendment H12 host-noise threshold of the A/A control.",
   "required":["wait_max_ratio","spin_ratio","two_children_ratio","native_min_share","touch_mib","touch_min_mib","untouched_mib","quiet_mib","control_seconds","native_megabytes","short_children","aa_pressure"],
   "properties":{"wait_max_ratio":{"const":0.10},"spin_ratio":{"const":[0.85,1.15]},"two_children_ratio":{"const":[1.70,2.30]},"native_min_share":{"const":0.9},
    "touch_mib":{"const":64},"touch_min_mib":{"const":60},"untouched_mib":{"const":1024},"quiet_mib":{"const":16},"control_seconds":{"const":1.0},"native_megabytes":{"const":256},"short_children":{"const":20},
    "aa_pressure":{"type":"object","additionalProperties":false,"required":["factor","min_usec"],
     "properties":{"factor":{"type":"number","exclusiveMinimum":1},"min_usec":{"type":"integer","minimum":0}}}}},
  "resolution":{"const":{"perf_counter_ns":1,"cpu_stat_usec":1,"rusage_usec":1,"memory_bytes":4096}},
  "effects":{"const":{"relative":0.05,"min_abs_ns_per_unit":0,"min_blocks":3}},
  "coverage":{"const":{"units":10000,"sigma_log":[0.02,0.10],"seed":20261007,"bounds":{"two_look":0.0432,"c_one_look":0.0297}}},
  "accounting":{"const":{"resolution_usec":1}},
  "capacity":{"description":"Task 22 (Amendment H6, spec 8.3): the capacity scope bounds; a trial above trial_seconds_max refuses the plan (never shrunk).",
   "type":"object","additionalProperties":false,"required":["trial_seconds_max","latency_samples_max","trials","smoke_clients"],
   "properties":{"trial_seconds_max":{"type":"integer","minimum":1,"maximum":120},"latency_samples_max":{"type":"integer","minimum":1,"maximum":4096},
    "trials":{"const":{"smoke":1,"decision":3}},"smoke_clients":{"const":[1]}}},
  "decision_policies":{"type":"object","additionalProperties":false,
   "description":"Task 13 (spec 10, Amendment G9.1, G13.4): exactly the three framework rule policies, closed with the template keys. A demonstration_only policy has state demonstration. FR3: a unit-threshold policy is project data (schemas/bench-protocol.json decision_policies).",
   "required":["owner","demo-latency-2x","demo-cpu-40"],
   "properties":{"owner":{"$ref":"#/properties/decision_policies/$defs/rule_policy"},
    "demo-latency-2x":{"$ref":"#/properties/decision_policies/$defs/rule_policy"},
    "demo-cpu-40":{"$ref":"#/properties/decision_policies/$defs/rule_policy"}},
   "$defs":{
    "state":{"enum":["owner-must-fill","demonstration","approved"]},
    "demonstration_state":{"if":{"properties":{"demonstration_only":{"const":true}},"required":["demonstration_only"]},"then":{"properties":{"state":{"const":"demonstration"}}}},
    "rule_policy":{"type":"object","additionalProperties":false,
     "required":["state","demonstration_only","objective","metric","modes","points","relative_threshold","min_abs_saving_ns_per_call",
                 "absolute_target_ns_per_unit","target_margin","pool_cpu_guard","limits","sizes","concurrency"],
     "properties":{"state":{"$ref":"#/properties/decision_policies/$defs/state"},
      "demonstration_only":{"type":"boolean"},
      "objective":{"type":["string","null"],"minLength":1,"maxLength":300},
      "metric":{"enum":["wall_ns_per_unit","cpu_ns_per_unit",null]},
      "modes":{"type":["array","null"],"minItems":1,"uniqueItems":true,"items":{"enum":["warm","cold"]}},
      "points":{"type":["array","null"],"minItems":1,"uniqueItems":true,"items":{"enum":["baseline","full-dataset"]}},
      "relative_threshold":{"type":["number","null"],"exclusiveMinimum":0,"exclusiveMaximum":1},
      "min_abs_saving_ns_per_call":{"type":["integer","null"],"minimum":0},
      "absolute_target_ns_per_unit":{"type":["number","null"],"exclusiveMinimum":0},
      "target_margin":{"type":["number","null"],"minimum":0},
      "pool_cpu_guard":{"type":["number","null"],"minimum":0},
      "limits":{"type":"object","additionalProperties":false,"required":["cpu_regression","latency_regression","memory_regression"],
       "properties":{"cpu_regression":{"type":["number","null"],"minimum":0},"latency_regression":{"type":["number","null"],"minimum":0},
        "memory_regression":{"type":["number","null"],"minimum":0}}},
      "sizes":{"type":["array","null"],"minItems":1,"uniqueItems":true,"items":{"enum":["tiny","small","medium","large"]}},
      "concurrency":{"type":["array","null"],"minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1}}},
     "allOf":[{"$ref":"#/properties/decision_policies/$defs/demonstration_state"}]}}}
,
  "routes":{"description":"Phase 2 Task 19 (FR6 N4): the label of each data transfer route of a C caller row; the report and the summary carry it.","type":"object","additionalProperties":false,"required":["stdio","shm","inproc"],"properties":{"stdio":{"type":"string","minLength":1,"maxLength":300},"shm":{"type":"string","minLength":1,"maxLength":300},"inproc":{"type":"string","minLength":1,"maxLength":300}}},
  "native_timing":{"description":"Phase 2 Task 19 (FR6 N4): a C kernel row self-timing agrees with its bracket wall within max(abs_ns, rel x wall); its self CPU is at most the cgroup CPU plus abs_ns.","type":"object","additionalProperties":false,"required":["abs_ns","rel"],"properties":{"abs_ns":{"type":"integer","minimum":0},"rel":{"type":"number","minimum":0,"maximum":1}}}
 }}
