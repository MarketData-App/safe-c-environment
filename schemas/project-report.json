{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["schema_version","run_id","project","project_dir","started_at","finished_at","elapsed_seconds","development","verdict","exit_code",
   "framework_identity","framework_differences","project_identity","source_identity","image_id","gates","runtime","blockers","stopped_after","evidence_directory"],
 "properties":{
  "schema_version":{"const":1},
  "run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
  "project":{"type":["string","null"],"pattern":"^[a-z][a-z0-9-]{1,62}$"},
  "project_dir":{"type":"string","minLength":1},
  "started_at":{"type":"string","minLength":1},
  "finished_at":{"type":"string","minLength":1},
  "elapsed_seconds":{"type":"number","minimum":0},
  "development":{"type":"boolean"},
  "verdict":{"enum":["PASS","FAIL","BLOCKED","PASS_UNQUALIFIED_FRAMEWORK"]},
  "exit_code":{"enum":[0,1,2,3]},
  "framework_identity":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
  "framework_differences":{"type":"array","items":{"type":"string"}},
  "project_identity":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
  "source_identity":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
  "image_id":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
  "gates":{"type":"array","minItems":23,"maxItems":23,"items":{"type":"object","additionalProperties":false,
    "required":["name","status","details","evidence_paths"],
    "properties":{"name":{"enum":["format","gcc-O0","gcc-O2","clang-O0","clang-O2","hardened","tidy","csa","gcc-analyzer","ast",
        "asan","ubsan","integer","msan","tsan","unit","integration","coverage","fuzz-replay","fuzz-exploration","clusterfuzzlite","inventory","review-protocol"]},
      "status":{"enum":["PASS","FAIL","BLOCKED"]},"details":{"type":"object"},
      "evidence_paths":{"type":"array","items":{"type":"string"}}}}},
  "runtime":{"type":"object","additionalProperties":false,"required":["status"],
    "properties":{"status":{"enum":["PASS","FAIL","BLOCKED"]},"reason":{"type":"string"},"program":{"type":"string"},
      "args":{"type":"array","items":{"type":"string"}},"exit_code":{"type":["integer","null"]},"expected_exit":{"type":"integer"},
      "image_id":{"type":"string"},"tag":{"type":"string"},"members":{"type":"object","additionalProperties":{"type":"string"}},
      "container_id":{"type":"string"},"profile":{"const":"runtime-demo"},"evidence_paths":{"type":"array","items":{"type":"string"}}}},
  "blockers":{"type":"array","items":{"type":"string"}},
  "stopped_after":{"type":["string","null"]},
  "evidence_directory":{"type":"string"}}}
