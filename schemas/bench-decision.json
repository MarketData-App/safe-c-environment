{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"Task 13 (spec 10, Amendments G9.6, H5, H15.2, H16.1): the closed decision record. No score property exists anywhere. A rule-policy record holds an outcome, a rule 1-8 and an adoption outcome and has no qualification or sensitivity object; a unit-threshold record (any policy name other than the three framework rule policies; FR3: the policy is project data) holds null outcome fields and the per-unit records in units (Task 15: one closed record per policy unit, in the policy's unit order; a rule-policy record has no units). No record authorizes adoption or a rollout.",
 "required":["schema_version","run_id","case","local","policy","source_identity_run","source_identity_decision","stale","image_id","evidence_quality",
             "outcome","rule","adoption_outcome","demonstration_outcome","adoption_note","adoption_authorized","cgroup_identity_unrecorded",
             "sensitivity","windows","qualification","reasons","comparisons","items","summary"],
 "$defs":{
  "outcome":{"enum":["KEEP_PYTHON","OPTIMIZE_PYTHON_FIRST","USE_EXISTING_PYTHON_LIBRARY","CONSIDER_PYTHON_CONCURRENCY","C_CANDIDATE_FOR_REVIEW","INCONCLUSIVE","INVALID_EXPERIMENT"]},
  "hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "text200":{"type":["string","null"],"maxLength":200},
  "number_or_null":{"type":["number","null"]},
  "summary_text":{"type":"string","maxLength":600},
  "unit_name":{"type":"string","pattern":"^[a-z0-9-]{1,16}/(full-dataset|single-record)$","description":"FR3: <selector>/<full-dataset|single-record>; the selectors are the project's models"},
  "unit_verdict":{"enum":["KEEP_PYTHON","PREFER_C","INCONCLUSIVE","INVALID_EXPERIMENT"]},
  "unit_reason":{"enum":["python-under-threshold","python-near-threshold","python-at-threshold","python-evidence-missing","py-reference-not-measured",
                         "c-reliably-faster","c-not-eligible","c-evidence-missing","c-not-reliably-faster","ineligible-row","run-invalid","bound-unattainable",
                         "both-conditions-met","base-under-threshold","base-threshold-undecided","base-not-measured","candidate-not-measured",
                         "candidate-margin-not-met","candidate-margin-undecided","candidate-not-eligible"]},
  "margin_keep_reason":{"enum":["base-under-threshold","base-threshold-undecided","base-not-measured","candidate-not-measured",
                                "candidate-margin-not-met","candidate-margin-undecided","candidate-not-eligible"]},
  "margin_decision":{"enum":["met","not-met","undecided","not-measured"]},
  "margin_record":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,
   "description":"EX-18a: the two-condition rule of the unit (the policy's margin_rule): the base condition with its bounds L_Pi (low_ms) and H_Pi (high_ms) against the threshold, and per declared route the candidate condition with the order-statistic interval of the median of the per-block ratios at alpha/k (k: every measured candidate row of the unit), the route verdict and every failed or undecided condition. Null without the rule or for an invalid experiment.",
   "required":["margin","ratio_bound","threshold_ms","base_variants","candidate_variants","k","base","routes"],
   "properties":{"margin":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"ratio_bound":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
    "threshold_ms":{"type":"number"},
    "base_variants":{"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"type":"string","maxLength":40}},
    "candidate_variants":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"string","maxLength":40}},
    "k":{"type":"integer","minimum":0,"maximum":12},
    "base":{"type":"object","additionalProperties":false,"required":["rows","P","low_ms","high_ms","decision","reason","detail"],
     "properties":{"rows":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/unit_label"}},"P":{"type":["string","null"],"maxLength":200},
      "low_ms":{"$ref":"#/$defs/unit_ms"},"high_ms":{"$ref":"#/$defs/unit_ms"},"decision":{"$ref":"#/$defs/margin_decision"},
      "reason":{"enum":["base-under-threshold","base-threshold-undecided","base-not-measured",null]},"detail":{"type":["string","null"],"maxLength":200}},
     "allOf":[{"if":{"properties":{"decision":{"const":"met"}}},"then":{"properties":{"reason":{"const":null}}},"else":{"properties":{"reason":{"type":"string"}}}}]},
    "routes":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,
     "required":["route","safe","candidate","ratio","ratio_low","ratio_high","decision","detail","verdict","reasons","rows"],
     "properties":{"route":{"enum":["stdio","shm","inproc"]},"safe":{"type":"boolean"},"candidate":{"type":["string","null"],"maxLength":200},
      "ratio":{"$ref":"#/$defs/number_or_null"},"ratio_low":{"$ref":"#/$defs/number_or_null"},"ratio_high":{"$ref":"#/$defs/number_or_null"},
      "decision":{"$ref":"#/$defs/margin_decision"},"detail":{"type":["string","null"],"maxLength":200},"verdict":{"enum":["PREFER_C","KEEP_PYTHON"]},
      "reasons":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/margin_keep_reason"}},
      "rows":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["label","ratio","ratio_low","ratio_high","decision"],
       "properties":{"label":{"$ref":"#/$defs/unit_label"},"ratio":{"$ref":"#/$defs/number_or_null"},"ratio_low":{"$ref":"#/$defs/number_or_null"},
        "ratio_high":{"$ref":"#/$defs/number_or_null"},"decision":{"enum":["met","not-met","undecided"]}}}}},
     "allOf":[{"if":{"properties":{"verdict":{"const":"PREFER_C"}}},"then":{"properties":{"decision":{"const":"met"},"reasons":{"maxItems":0}}},
               "else":{"properties":{"reasons":{"minItems":1}}}}]}}},
   "allOf":[{"description":"EX18a-A03: a route that prefers the candidate needs the base condition met",
             "if":{"properties":{"routes":{"contains":{"properties":{"verdict":{"const":"PREFER_C"}},"required":["verdict"]}}},"required":["routes"]},
             "then":{"properties":{"base":{"properties":{"decision":{"const":"met"}}}}}}]}]},
  "unit_label":{"type":"string","minLength":1,"maxLength":200},
  "unit_text":{"type":["string","null"],"maxLength":600},
  "unit_ms":{"type":["number","null"]},
  "unit_count":{"type":["integer","null"],"minimum":0},
  "unit_interval":{"type":"object","additionalProperties":false,"required":["median_ms","low_ms","high_ms"],
   "properties":{"median_ms":{"$ref":"#/$defs/unit_ms"},"low_ms":{"$ref":"#/$defs/unit_ms"},"high_ms":{"$ref":"#/$defs/unit_ms"}}},
  "unit_row":{"type":"object","additionalProperties":false,"required":["label","median_ms","low_ms","high_ms"],
   "properties":{"label":{"$ref":"#/$defs/unit_label"},"median_ms":{"$ref":"#/$defs/unit_ms"},"low_ms":{"$ref":"#/$defs/unit_ms"},"high_ms":{"$ref":"#/$defs/unit_ms"}}},
  "unit_bound":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["value_ms","row"],
   "properties":{"value_ms":{"$ref":"#/$defs/unit_ms"},"row":{"type":["string","null"],"maxLength":200}}}]},
  "unit_c":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,
   "required":["label","route","route_label","median_ms","low_ms","high_ms","ratio","ratio_low","ratio_high","saving_ms","c_under_threshold","cpu_ms","peak"],
   "properties":{"label":{"$ref":"#/$defs/unit_label"},"route":{"enum":["stdio","shm","inproc",null]},"route_label":{"type":["string","null"],"maxLength":300},
    "median_ms":{"$ref":"#/$defs/unit_ms"},"low_ms":{"$ref":"#/$defs/unit_ms"},"high_ms":{"$ref":"#/$defs/unit_ms"},
    "ratio":{"type":"number"},"ratio_low":{"$ref":"#/$defs/unit_ms"},"ratio_high":{"$ref":"#/$defs/unit_ms"},"saving_ms":{"$ref":"#/$defs/unit_ms"},
    "c_under_threshold":{"enum":[true,false,"unknown"]},"cpu_ms":{"$ref":"#/$defs/unit_ms"},"peak":{"type":["integer","null"],"minimum":0}}}]},
  "unit_rank":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["n","k"],
   "properties":{"n":{"type":"integer","minimum":1},"k":{"type":["integer","null"],"minimum":1}}}]},
  "unit_rates":{"type":"object","maxProperties":8,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
  "unit_record":{"type":"object","additionalProperties":false,
   "description":"Task 15 (G9.6, G9.7, H16.3, H21.6, I8.2, I8.3, I15.2, I15.4): one unit record under a unit-threshold policy. PREFER_C is not C_CANDIDATE_FOR_REVIEW and authorizes nothing (G9.8).",
   "required":["unit","rows_per_request","blocks","look","alpha","k_pi","k_gamma","k_safe","verdict","reason","detail","verdict_safe_route","reason_safe_route",
               "failed_conditions","default_action","next_action","framework_basis","framework_label","H_pi","L_pi","P","python_rows","C","C_safe","c_rows",
               "less_safe_label","cold","missing_rows","panel","panel_records","diagnostics","possible_python_improvements","ranks","trend","sensitivity",
               "project_report","reference_admit_excluded","library_label","library_overhead_ns_per_row","envelope_note","extension","summary_line","adoption_authorized"],
   "properties":{
    "unit":{"$ref":"#/$defs/unit_name"},"rows_per_request":{"type":["integer","null"],"minimum":1},"blocks":{"type":"integer","minimum":1,"maximum":24},
    "look":{"enum":[1,2]},"alpha":{"enum":[0.025,0.0125]},
    "k_pi":{"type":["integer","null"],"minimum":0,"maximum":12},"k_gamma":{"type":["integer","null"],"minimum":0,"maximum":12},"k_safe":{"type":["integer","null"],"minimum":0,"maximum":12},
    "verdict":{"$ref":"#/$defs/unit_verdict"},"reason":{"$ref":"#/$defs/unit_reason"},
    "detail":{"enum":["coverage-unqualified","panel-status","window-pressure","window-envelope-mismatch","window-chain","extension-exhausted",null]},
    "verdict_safe_route":{"$ref":"#/$defs/unit_verdict"},"reason_safe_route":{"$ref":"#/$defs/unit_reason"},
    "failed_conditions":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"enum":["framework-unqualified","project-gates-failed","project-check-blocked","opportunity-not-approved"]}},
    "default_action":{"enum":["KEEP_PYTHON","PREFER_C",null]},
    "next_action":{"type":["string","null"],"maxLength":200},
    "framework_basis":{"enum":["manifest","local","failed","stale","none"]},
    "framework_label":{"enum":["manifest recorded","framework qualified locally, not published","framework unqualified"]},
    "H_pi":{"$ref":"#/$defs/unit_bound"},"L_pi":{"$ref":"#/$defs/unit_bound"},
    "P":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["label","median_ms","low_ms","high_ms","cpu_ms","peak"],
     "properties":{"label":{"$ref":"#/$defs/unit_label"},"median_ms":{"$ref":"#/$defs/unit_ms"},"low_ms":{"$ref":"#/$defs/unit_ms"},"high_ms":{"$ref":"#/$defs/unit_ms"},
      "cpu_ms":{"$ref":"#/$defs/unit_ms"},"peak":{"type":["integer","null"],"minimum":0}}}]},
    "python_rows":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/unit_row"}},
    "C":{"$ref":"#/$defs/unit_c"},"C_safe":{"$ref":"#/$defs/unit_c"},
    "c_rows":{"type":"array","maxItems":24,"items":{"type":"object","additionalProperties":false,"required":["label","route","route_label","median_ms"],
     "properties":{"label":{"$ref":"#/$defs/unit_label"},"route":{"enum":["stdio","shm","inproc",null]},"route_label":{"type":["string","null"],"maxLength":300},
      "median_ms":{"$ref":"#/$defs/unit_ms"}}}},
    "less_safe_label":{"enum":["in-process shared library: native code shares the interpreter address space; a C defect can corrupt the interpreter (fast route, least safe)",null]},
    "cold":{"type":"object","additionalProperties":false,"required":["label","P","C","C_safe","cold_start_flag"],
     "properties":{"label":{"const":"reported, not the verdict basis"},
      "P":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/unit_row"}]},"C":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/unit_row"}]},
      "C_safe":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/unit_row"}]},
      "cold_start_flag":{"enum":["deployment starts a worker per request: the cold values apply",null]}}},
    "missing_rows":{"type":"array","maxItems":48,"items":{"type":"object","additionalProperties":false,"required":["label","reason"],
     "properties":{"label":{"$ref":"#/$defs/unit_label"},"reason":{"type":"string","maxLength":300}}}},
    "panel":{"oneOf":[{"type":"null"},{"type":"array","maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["cell","P","C"],
     "properties":{"cell":{"$ref":"#/$defs/unit_label"},"P":{"$ref":"#/$defs/unit_interval"},"C":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/unit_interval"}]}}}}]},
    "panel_records":{"oneOf":[{"type":"null"},{"type":"array","maxItems":6,"items":{"type":"object","additionalProperties":false,
     "required":["cell","category","values","level"],
     "description":"FR5 (ruling FR5-R1 item 1): per panel record the cell name and category label of the project's cell rule, its report values (report entry name: value) and its fallback level",
     "properties":{"cell":{"type":["string","null"],"maxLength":64},"category":{"type":["string","null"],"maxLength":16},
      "values":{"type":"object","maxProperties":8,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},"additionalProperties":{"type":["number","null"]}},
      "level":{"enum":[0,1,2,null]}}}}]},
    "diagnostics":{"type":"object","additionalProperties":false,"required":["label","entries"],
     "properties":{"label":{"const":"diagnostic, never a verdict"},"entries":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":300}}}},
    "possible_python_improvements":{"type":"array","maxItems":16,"items":{"type":"string","maxLength":120}},
    "ranks":{"type":"object","additionalProperties":false,"required":["rows","C","C_safe"],
     "properties":{"rows":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["label","n","k_upper","k_lower"],
       "properties":{"label":{"$ref":"#/$defs/unit_label"},"n":{"type":"integer","minimum":1},"k_upper":{"type":["integer","null"],"minimum":1},"k_lower":{"type":["integer","null"],"minimum":1}}}},
      "C":{"$ref":"#/$defs/unit_rank"},"C_safe":{"$ref":"#/$defs/unit_rank"}}},
    "trend":{"type":"object","additionalProperties":false,"required":["tau","p_two_sided","n","label"],
     "properties":{"tau":{"type":["number","null"],"minimum":-1,"maximum":1},"p_two_sided":{"type":["number","null"],"minimum":0,"maximum":1},"n":{"type":"integer","minimum":0},
      "label":{"const":"trend of P over blocks (assumption check, never a verdict)"}}},
    "sensitivity":{"type":"object","additionalProperties":false,
     "required":["sigma_hat","sigma_log","rows","blocks","level","caveat","k_gamma","rank_gamma","k_safe","rank_safe","all_rows_fast","one_row_fast","sentence"],
     "properties":{"sigma_hat":{"type":["number","null"],"minimum":0},"sigma_log":{"type":["number","null"],"minimum":0},"rows":{"type":"integer","minimum":0},
      "blocks":{"type":"integer","minimum":0},"level":{"type":["number","null"],"minimum":0},"caveat":{"$ref":"#/$defs/unit_text"},
      "k_gamma":{"type":"integer","minimum":0},"rank_gamma":{"$ref":"#/$defs/unit_count"},"k_safe":{"type":"integer","minimum":0},"rank_safe":{"$ref":"#/$defs/unit_count"},
      "all_rows_fast":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/unit_rates"}]},
      "one_row_fast":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["label","fast_row_rate"],
       "properties":{"label":{"const":"power is lower when only one C row is fast"},"fast_row_rate":{"$ref":"#/$defs/unit_rates"}}}]},
      "sentence":{"const":"A C advantage smaller than the ratios with high power at this noise level can stay unrecognized; then the action is KEEP_PYTHON (order 9) or INCONCLUSIVE where the order table says so."}}},
    "project_report":{"description":"FR3 (was the I8.3 model report): the project's documented report of the unit's selector (project-report.json of the run); never a verdict.",
     "oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["label","tables"],
      "properties":{"label":{"const":"documented metric, never a verdict"},"tables":{"type":"object","maxProperties":16}}}]},
    "reference_admit_excluded":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["row","brent","bump"],
     "properties":{"row":{"type":"integer","minimum":0},"brent":{"type":"integer","minimum":0},"bump":{"type":"integer","minimum":0}}}]},
    "library_label":{"type":["string","null"],"minLength":1,"maxLength":120,"description":"G2.3: the label of the project protocol's library_report for a listed selector; null otherwise"},
    "library_overhead_ns_per_row":{"type":["number","null"]},
    "envelope_note":{"$ref":"#/$defs/unit_text"},
    "extension":{"type":"object","additionalProperties":false,"required":["trigger","note"],
     "properties":{"trigger":{"type":"boolean"},"note":{"enum":["extension-not-run",null]}}},
    "summary_line":{"type":"string","minLength":1,"maxLength":600},
    "adoption_authorized":{"const":false},
    "margin_rule":{"$ref":"#/$defs/margin_record"}},
   "allOf":[
    {"if":{"properties":{"verdict":{"const":"INVALID_EXPERIMENT"}}},"then":{"properties":{"default_action":{"const":null},"reason":{"enum":["run-invalid","ineligible-row"]},
      "verdict_safe_route":{"const":"INVALID_EXPERIMENT"}}}},
    {"if":{"properties":{"verdict":{"const":"INCONCLUSIVE"}}},"then":{"properties":{"default_action":{"const":"KEEP_PYTHON"},
      "reason":{"enum":["python-near-threshold","python-at-threshold","python-evidence-missing","py-reference-not-measured","c-not-eligible","c-evidence-missing","bound-unattainable"]}}}},
    {"if":{"properties":{"verdict":{"const":"KEEP_PYTHON"}}},"then":{"properties":{"default_action":{"const":"KEEP_PYTHON"},"reason":{"enum":["python-under-threshold","c-not-reliably-faster",
      "base-under-threshold","base-threshold-undecided","base-not-measured","candidate-not-measured","candidate-margin-not-met","candidate-margin-undecided","candidate-not-eligible"]}}}},
    {"if":{"properties":{"verdict":{"const":"PREFER_C"}}},"then":{"properties":{"default_action":{"const":"PREFER_C"},"reason":{"enum":["c-reliably-faster","both-conditions-met"]},"next_action":{"type":"string"}}},
     "else":{"properties":{"next_action":{"const":null}}}},
    {"if":{"properties":{"verdict_safe_route":{"const":"PREFER_C"}}},"then":{"properties":{"reason_safe_route":{"enum":["c-reliably-faster","both-conditions-met"]}}}},
    {"if":{"properties":{"verdict_safe_route":{"const":"KEEP_PYTHON"}}},"then":{"properties":{"reason_safe_route":{"enum":["python-under-threshold","c-not-reliably-faster",
      "base-under-threshold","base-threshold-undecided","base-not-measured","candidate-not-measured","candidate-margin-not-met","candidate-margin-undecided","candidate-not-eligible"]}}}},
    {"if":{"required":["margin_rule"],"properties":{"margin_rule":{"type":"object"}}},
     "then":{"description":"EX-18a: under the two-condition rule a unit either prefers the candidate (both conditions met) or keeps the base with a reason of the rule",
      "properties":{"verdict":{"enum":["PREFER_C","KEEP_PYTHON"]},"verdict_safe_route":{"enum":["PREFER_C","KEEP_PYTHON"]},
       "reason":{"anyOf":[{"const":"both-conditions-met"},{"$ref":"#/$defs/margin_keep_reason"}]},
       "reason_safe_route":{"anyOf":[{"const":"both-conditions-met"},{"$ref":"#/$defs/margin_keep_reason"}]}}}},
    {"if":{"anyOf":[{"properties":{"reason":{"anyOf":[{"const":"both-conditions-met"},{"$ref":"#/$defs/margin_keep_reason"}]}}},
                    {"properties":{"reason_safe_route":{"anyOf":[{"const":"both-conditions-met"},{"$ref":"#/$defs/margin_keep_reason"}]}}}]},
     "then":{"required":["margin_rule"],"properties":{"margin_rule":{"type":"object"}}}},
    {"if":{"properties":{"reason":{"const":"base-under-threshold"}}},"then":{"properties":{"reason_safe_route":{"enum":["base-under-threshold","candidate-not-measured"]}}}},
    {"if":{"properties":{"reason":{"const":"base-threshold-undecided"}}},"then":{"properties":{"reason_safe_route":{"enum":["base-threshold-undecided","candidate-not-measured"]}}}},
    {"if":{"properties":{"reason":{"const":"base-not-measured"}}},"then":{"properties":{"reason_safe_route":{"enum":["base-not-measured","candidate-not-measured"]}}}},
    {"if":{"properties":{"verdict_safe_route":{"const":"INVALID_EXPERIMENT"}}},"then":{"properties":{"reason_safe_route":{"enum":["run-invalid","ineligible-row"]}}}},
    {"if":{"properties":{"verdict_safe_route":{"const":"INCONCLUSIVE"}}},"then":{"properties":{"reason_safe_route":{"enum":["python-near-threshold","python-at-threshold",
      "python-evidence-missing","py-reference-not-measured","c-not-eligible","c-evidence-missing","bound-unattainable"]}}}},
    {"if":{"anyOf":[{"properties":{"reason":{"enum":["c-not-eligible","candidate-not-eligible"]}}},{"properties":{"reason_safe_route":{"enum":["c-not-eligible","candidate-not-eligible"]}}}]},
     "then":{"properties":{"failed_conditions":{"minItems":1}}},"else":{"properties":{"failed_conditions":{"maxItems":0}}}},
    {"if":{"anyOf":[{"properties":{"verdict":{"const":"PREFER_C"}}},{"properties":{"verdict_safe_route":{"const":"PREFER_C"}}}]},
     "then":{"properties":{"framework_label":{"enum":["manifest recorded","framework qualified locally, not published"]}}}},
    {"if":{"properties":{"reason":{"const":"run-invalid"}}},"then":{"properties":{"verdict_safe_route":{"const":"INVALID_EXPERIMENT"},"reason_safe_route":{"const":"run-invalid"}}}},
    {"if":{"properties":{"reason":{"const":"ineligible-row"}}},"then":{"properties":{"verdict_safe_route":{"const":"INVALID_EXPERIMENT"},"reason_safe_route":{"const":"ineligible-row"}}}},
    {"if":{"properties":{"reason":{"const":"python-under-threshold"}}},"then":{"properties":{"verdict_safe_route":{"const":"KEEP_PYTHON"},"reason_safe_route":{"const":"python-under-threshold"}}}},
    {"if":{"properties":{"reason":{"const":"python-near-threshold"}}},"then":{"properties":{"verdict_safe_route":{"const":"INCONCLUSIVE"},"reason_safe_route":{"const":"python-near-threshold"}}}},
    {"if":{"properties":{"reason":{"const":"python-at-threshold"}}},"then":{"properties":{"verdict_safe_route":{"const":"INCONCLUSIVE"},"reason_safe_route":{"const":"python-at-threshold"}}}},
    {"if":{"properties":{"reason":{"const":"python-evidence-missing"}}},"then":{"properties":{"verdict_safe_route":{"const":"INCONCLUSIVE"},"reason_safe_route":{"const":"python-evidence-missing"}}}},
    {"if":{"properties":{"reason":{"const":"py-reference-not-measured"}}},"then":{"properties":{"verdict_safe_route":{"const":"INCONCLUSIVE"},"reason_safe_route":{"const":"py-reference-not-measured"}}}},
    {"if":{"properties":{"unit":{"pattern":"/single-record$"}}},
     "then":{"properties":{"panel_records":{"type":"array"},"panel":{"type":"array"}}},"else":{"properties":{"panel_records":{"type":"null"},"panel":{"type":"null"}}}},
    {"if":{"properties":{"library_label":{"type":"null"}}},
     "then":{"properties":{"reference_admit_excluded":{"type":"null"},"library_overhead_ns_per_row":{"type":"null"}}}},
    {"description":"EX18a-A03: under the two-condition rule a unit that prefers the candidate has the base condition met and a route that prefers the candidate",
     "if":{"required":["verdict","margin_rule"],"properties":{"verdict":{"const":"PREFER_C"},"margin_rule":{"type":"object"}}},
     "then":{"properties":{"margin_rule":{"properties":{"base":{"properties":{"decision":{"const":"met"}}},
       "routes":{"contains":{"properties":{"verdict":{"const":"PREFER_C"}},"required":["verdict"]}}}}}}},
    {"description":"EX18a-A03: under the two-condition rule a safe-route verdict that prefers the candidate has the base condition met and a safe route that prefers the candidate",
     "if":{"required":["verdict_safe_route","margin_rule"],"properties":{"verdict_safe_route":{"const":"PREFER_C"},"margin_rule":{"type":"object"}}},
     "then":{"properties":{"margin_rule":{"properties":{"base":{"properties":{"decision":{"const":"met"}}},
       "routes":{"contains":{"properties":{"verdict":{"const":"PREFER_C"},"safe":{"const":true}},"required":["verdict","safe"]}}}}}}}]}
 },
 "properties":{
  "schema_version":{"const":1},
  "run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
  "case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "local":{"type":"boolean"},
  "policy":{"type":"object","additionalProperties":false,"required":["name","sha256","demonstration_only","filled"],
   "properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},"sha256":{"$ref":"#/$defs/hex64"},
    "demonstration_only":{"type":"boolean"},"filled":{"type":"boolean"},
    "windows":{"const":true,"description":"EX-18b (Task A9): present only when the unit-threshold policy declares windows (project data); the record then holds the window chain object"}}},
  "source_identity_run":{"$ref":"#/$defs/hex64"},
  "source_identity_decision":{"$ref":"#/$defs/hex64"},
  "stale":{"type":"boolean"},
  "image_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
  "evidence_quality":{"enum":["decision","exploratory (smoke)","stale","owner fixture, local run, aggregate"]},
  "outcome":{"anyOf":[{"$ref":"#/$defs/outcome"},{"type":"null"}]},
  "rule":{"anyOf":[{"type":"integer","minimum":1,"maximum":8},{"type":"null"}]},
  "adoption_outcome":{"anyOf":[{"$ref":"#/$defs/outcome"},{"type":"null"}]},
  "demonstration_outcome":{"anyOf":[{"$ref":"#/$defs/outcome"},{"type":"null"}]},
  "adoption_note":{"type":"string","maxLength":200},
  "adoption_authorized":{"const":false,"description":"No decision record can authorize adoption or a rollout (brief section 12 item 8; P15 recommendation-deploys)."},
  "cgroup_identity_unrecorded":{"type":"boolean","description":"True when the run has no recorded cgroup identity rows; evidence_quality keeps its closed enum (P3R6-01)."},
  "sensitivity":{"description":"Amendment H16.1: null, or the owner confirmation of the coverage record (ledger entry id and coverage record sha256).",
   "oneOf":[{"type":"null"},
    {"type":"object","additionalProperties":false,"required":["owner_confirmation"],
     "properties":{"owner_confirmation":{"type":"object","additionalProperties":false,"required":["ledger_id","coverage_sha256"],
