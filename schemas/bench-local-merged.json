{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"EX-19 (Phase 3 Task 31, framework part; Amendment H10, H15.2): the closed merged document of a local decision run (tools/bench_local_decision.py). The host writes it from the accepted closed aggregates of the run's jobs (one redacted container per timing session) and its own records (cgroup identities, gates); it is the only input of a local decision. It holds numbers, enums, hex digests and patterned names only, no free-form string and no open object. problems lists the stable codes that make the status other than VALID. T5-R1: jobs[] names whether a job is partial (spec 12 L4: its rows are fewer than the run's rows; its rows and digests are null and it adds no count block); partial-slice and rules-failed are the problems of T5-A01 and T5-A02. A window attempt also names its window, attempt, plan version, `extends` (the record sha256 of the nearest earlier final position, as in run.json) and its attempt outcome.",
 "required":["schema_version","run_id","case","dataset_sha256","rows","status","problems","jobs","timings","not_run","accounting"],
 "$defs":{"cnt":{"type":"integer","minimum":0},"hex64":{"type":"string","pattern":"^[0-9a-f]{64}$"},"name":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},
  "num":{"type":["number","null"]},
  "dist":{"type":"object","additionalProperties":false,"required":["n","median","iqr","min","max"],
   "properties":{"n":{"$ref":"#/$defs/cnt"},"median":{"$ref":"#/$defs/num"},"iqr":{"$ref":"#/$defs/num"},"min":{"$ref":"#/$defs/num"},"max":{"$ref":"#/$defs/num"}}},
  "series":{"type":"array","maxItems":24,"items":{"type":["number","null"],"minimum":0}},
  "counts":{"type":["array","null"],"maxItems":24,"items":{"type":["integer","null"],"minimum":0}},
  "control":{"enum":[null,"EQUAL","FASTER","SLOWER","INCONCLUSIVE"]}},
 "properties":{
  "schema_version":{"const":1},
  "run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
  "case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "dataset_sha256":{"$ref":"#/$defs/hex64"},
  "rows":{"type":"integer","minimum":0,"maximum":20000},
  "status":{"enum":["VALID","INVALID_EXPERIMENT","BLOCKED"]},
  "problems":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"enum":["doctor-blocked","guardrail-rejected","guardrail-blocked","before-run-failed","native-failed",
   "job-missing","job-failed","job-invalid","rows-unplanned","rows-missing","dataset-differs","case-differs","counts-differ","overhead-repeated",
   "cgroup-identity","children-not-isolated","image-changed","partial-slice","rules-failed"]}},
  "jobs":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["name","kind","status","selector","partial","rows","reference_sha256","result_sha256","cgroup_inode","isolated"],
   "properties":{"name":{"$ref":"#/$defs/name"},"kind":{"enum":["timing"]},"status":{"enum":["VALID","INVALID_EXPERIMENT","BLOCKED","MISSING"]},
    "selector":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},"partial":{"type":"boolean"},"rows":{"type":["integer","null"],"minimum":0,"maximum":20000},
    "reference_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/hex64"}]},"result_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/hex64"}]},
    "cgroup_inode":{"type":["integer","null"],"minimum":1},"isolated":{"type":["boolean","null"]}},
   "allOf":[{"if":{"properties":{"partial":{"const":true}}},"then":{"properties":{"rows":{"type":"null"},"reference_sha256":{"type":"null"},"result_sha256":{"type":"null"}}}}]}},
  "timings":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,
   "required":["job","point","scope","mode","variant","workers","tier","route","selector","unit","trials","eligible","wall_ns_per_unit","cpu_ns_per_unit",
               "block_ids","block_eligible","blocks","cpu_blocks","pressure_blocks","request_records","panel_passes","panel_status","call_blocks","cells"],
   "properties":{"job":{"$ref":"#/$defs/name"},"point":{"type":"string","pattern":"^[a-z0-9-]{3,48}$"},"scope":{"enum":["kernel","caller"]},"mode":{"enum":["warm","cold","direct"]},
    "variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},"workers":{"enum":["direct",1,2,4]},
    "tier":{"enum":["tiny","small","medium","large"]},"route":{"enum":[null,"stdio","shm","inproc"]},"selector":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},
    "unit":{"type":["string","null"],"pattern":"^[a-z0-9-]{1,16}/[a-z-]{3,24}$"},"trials":{"$ref":"#/$defs/cnt"},"eligible":{"type":"boolean"},
    "wall_ns_per_unit":{"$ref":"#/$defs/dist"},"cpu_ns_per_unit":{"$ref":"#/$defs/dist"},
    "block_ids":{"type":["array","null"],"maxItems":24,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":23}},
    "block_eligible":{"type":["array","null"],"maxItems":24,"items":{"type":"boolean"}},
    "blocks":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/series"}]},"cpu_blocks":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/series"}]},
    "pressure_blocks":{"$ref":"#/$defs/counts"},"request_records":{"$ref":"#/$defs/counts"},
    "panel_passes":{"type":["integer","null"],"minimum":1},"panel_status":{"type":"boolean"},"call_blocks":{"$ref":"#/$defs/counts"},
    "cells":{"type":["array","null"],"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["cell","blocks"],
     "properties":{"cell":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"},"blocks":{"$ref":"#/$defs/series"}}}}}}},
  "not_run":{"type":"array","maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["kind","trials"],
   "properties":{"kind":{"enum":["memory","capacity"]},"trials":{"type":"integer","minimum":1}}}},
  "reference_evals":{"type":"object","minProperties":1,"maxProperties":8,"propertyNames":{"pattern":"^[a-z0-9-]{1,16}$"},"additionalProperties":{"type":"integer","minimum":0}},
  "reference_admit_excluded":{"type":"object","additionalProperties":false,"required":["row","brent","bump"],
   "properties":{"row":{"$ref":"#/$defs/cnt"},"brent":{"$ref":"#/$defs/cnt"},"bump":{"$ref":"#/$defs/cnt"}}},
  "reference_overhead":{"type":"object","additionalProperties":false,"required":["library_overhead_ns_per_row"],"properties":{"library_overhead_ns_per_row":{"type":"number","minimum":0}}},
  "accounting":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,
   "required":["session","host_total_usec","window_usec","trial_sum_usec","trials","launcher_cgroup_inode","job_cgroup_inode","status"],
   "properties":{"session":{"$ref":"#/$defs/name"},"host_total_usec":{"type":["integer","null"],"minimum":0},"window_usec":{"type":"null"},
    "trial_sum_usec":{"$ref":"#/$defs/cnt"},"trials":{"$ref":"#/$defs/cnt"},"launcher_cgroup_inode":{"type":["integer","null"]},"job_cgroup_inode":{"type":["integer","null"]},
    "status":{"enum":["PASS","FAIL"]}}}},
  "window":{"type":"object","additionalProperties":false,"required":["id","attempt","plan_id","extends","outcome"],
   "properties":{"id":{"type":"string","pattern":"^[12][a-p]$"},"attempt":{"type":"integer","minimum":1,"maximum":3},"plan_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "extends":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/hex64"}]},
    "outcome":{"type":"object","additionalProperties":false,"required":["status","reason","controls"],
     "properties":{"status":{"enum":["PASS","BLOCKED","FAIL"]},"reason":{"enum":[null,"window-pressure","window-control-noise","run-invalid"]},
      "controls":{"type":"object","additionalProperties":false,"required":["base","candidate"],"properties":{"base":{"$ref":"#/$defs/control"},"candidate":{"$ref":"#/$defs/control"}}}}}}}
 },
 "allOf":[{"if":{"properties":{"problems":{"minItems":1}}},"then":{"properties":{"status":{"not":{"const":"VALID"}}}}},
          {"if":{"properties":{"status":{"const":"VALID"}}},"then":{"properties":{"problems":{"maxItems":0}}}}]}
