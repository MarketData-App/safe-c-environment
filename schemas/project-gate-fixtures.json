{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Project gate self-test: the hash-pinned fixture manifest (kind manifest) and one seeded-defect fixture per project gate (kind fixture).",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["manifest", "fixture"]}
  },
  "if": {"properties": {"kind": {"const": "manifest"}}},
  "then": {"$ref": "#/$defs/manifest"},
  "else": {"$ref": "#/$defs/fixture"},
  "$defs": {
    "relative": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_+-][A-Za-z0-9_./+-]*$"
    },
    "gate": {
      "enum": ["format", "gcc-O0", "gcc-O2", "clang-O0", "clang-O2", "hardened", "tidy", "csa",
               "gcc-analyzer", "ast", "asan", "ubsan", "integer", "msan", "tsan", "unit", "integration",
               "coverage", "fuzz-replay", "fuzz-exploration", "clusterfuzzlite", "inventory", "review-protocol"]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "base", "gates", "files"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "manifest"},
        "base": {"$ref": "#/$defs/relative"},
        "gates": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "files": {
          "type": "object",
          "minProperties": 23,
          "propertyNames": {"$ref": "#/$defs/relative"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "gate", "defect", "operations"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "fixture"},
        "gate": {"$ref": "#/$defs/gate"},
        "defect": {"type": "string", "minLength": 1, "maxLength": 600},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "path", "source"],
                "properties": {
                  "op": {"enum": ["add", "replace"]},
                  "path": {"$ref": "#/$defs/relative"},
                  "source": {"$ref": "#/$defs/relative"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "path"],
                "properties": {
                  "op": {"const": "delete"},
                  "path": {"$ref": "#/$defs/relative"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "path", "pointer", "value"],
                "properties": {
                  "op": {"enum": ["json_set", "json_append"]},
                  "path": {"$ref": "#/$defs/relative"},
                  "pointer": {"type": "string", "pattern": "^(/[A-Za-z0-9_~-]+)+$"},
                  "value": {}
                }
              }
            ]
          }
        }
      }
    }
  }
}
