{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "source_identity",
    "image_id",
    "binding",
    "receipt_hashes",
    "cases",
    "pipeline_variants",
    "commands",
    "measurements",
    "limitations",
    "scripted_workflow_trial",
    "live_agent_trial",
    "independent_enforcement",
    "handoff_ready",
    "application_started",
    "production_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree",
        "inputs"
      ],
      "properties": {
        "worktree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "receipt_hashes": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "control",
          "subchecks"
        ],
        "properties": {
          "id": {
            "pattern": "^E(0[1-9]|1[0-2])$",
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "control": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "subchecks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status",
                "control",
                "evidence_paths",
                "reason"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "control": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "evidence_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 4096
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "details": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "pipeline_variants": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "control",
          "evidence_paths",
          "reason",
          "parent",
          "variant"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "control": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4096
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object"
          },
          "parent": {
            "enum": [
              "P01",
              "P02",
              "P04",
              "P07",
              "P10",
              "P11",
              "P15"
            ]
          },
          "variant": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object"
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "scripted_workflow_trial": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_EXECUTED"
      ]
    },
    "live_agent_trial": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_EXECUTED"
      ]
    },
    "independent_enforcement": {
      "enum": [
        "PENDING",
        "VERIFIED",
        "FAILED"
      ]
    },
    "handoff_ready": {
      "const": false
    },
    "application_started": {
      "const": false
    },
    "production_authorized": {
      "const": false
    },
    "runtime": {
      "type": "object"
    },
    "starter": {
      "type": "object"
    }
  }
}
