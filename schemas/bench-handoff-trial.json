{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"Task 33 (spec 13, Amendment H9): the receipt of the performance handoff trial (prompts/performance-handoff-trial.md), artifacts/bench/handoff-trial.json. Written by the outer harness only; dev readiness reports its status in performance_details.handoff_trial, never as an axis.",
 "required":["schema_version","status","tooling_identity","source_identity","run_id","decisions","commands","edits","harness"],
 "properties":{
  "schema_version":{"const":1},
  "status":{"enum":["PASSED","FAILED","NOT_EXECUTED"]},
  "tooling_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "source_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "run_id":{"type":["string","null"],"pattern":"^[0-9a-f]{32}$"},
  "decisions":{"type":"array","maxItems":3,"uniqueItems":true,
   "items":{"type":"object","additionalProperties":false,"required":["policy","outcome","adoption_outcome"],
    "properties":{"policy":{"enum":["owner","demo-latency-2x","demo-cpu-40"]},
     "outcome":{"enum":["INVALID_EXPERIMENT","INCONCLUSIVE","KEEP_PYTHON","C_CANDIDATE_FOR_REVIEW","OPTIMIZE_PYTHON_FIRST","USE_EXISTING_PYTHON_LIBRARY","CONSIDER_PYTHON_CONCURRENCY"]},
     "adoption_outcome":{"enum":["INVALID_EXPERIMENT","INCONCLUSIVE","KEEP_PYTHON","C_CANDIDATE_FOR_REVIEW","OPTIMIZE_PYTHON_FIRST","USE_EXISTING_PYTHON_LIBRARY","CONSIDER_PYTHON_CONCURRENCY"]}}}},
  "commands":{"type":"integer","minimum":0,"maximum":1000},
  "edits":{"type":"integer","minimum":0,"maximum":1000},
  "harness":{"const":"outer"}},
 "allOf":[
  {"$comment":"T33-APP-01: only a FAILED receipt records edits or more than 8 commands; they are reasons for the failure.",
   "if":{"properties":{"status":{"not":{"const":"FAILED"}}}},
   "then":{"properties":{"edits":{"const":0},"commands":{"maximum":8}}}},
  {"$comment":"T33-APP-02: a PASSED receipt names its run, at least one decision and at least the three public commands.",
   "if":{"properties":{"status":{"const":"PASSED"}}},
   "then":{"properties":{"run_id":{"type":"string"},"decisions":{"minItems":1},"commands":{"minimum":3}}}},
  {"$comment":"S1-01: at most one decision per decision policy (uniqueItems compares whole objects). minContains 0 keeps a policy optional; maxContains 1 refuses a repeat.",
   "properties":{"decisions":{"allOf":[
    {"contains":{"properties":{"policy":{"const":"owner"}}},"minContains":0,"maxContains":1},
    {"contains":{"properties":{"policy":{"const":"demo-latency-2x"}}},"minContains":0,"maxContains":1},
    {"contains":{"properties":{"policy":{"const":"demo-cpu-40"}}},"minContains":0,"maxContains":1}]}}}]}
