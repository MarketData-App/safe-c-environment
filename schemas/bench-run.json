{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["schema_version","run_id","created_at","case","case_version","mode","dataset","plan","envelope","image_id","policy_sha256","fixtures_sha256","source_identity","runtime","admission","evidence","status","reasons"],
 "properties":{
  "schema_version":{"const":1},"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"created_at":{"type":"string","maxLength":40},
  "case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},"case_version":{"type":"integer","minimum":1},
  "mode":{"enum":["smoke","decision","profile","selftest","doctor","controls","oracle"]},
  "dataset":{"type":"object","additionalProperties":false,"required":["kind","size","seed","sha256","rows"],
   "properties":{"kind":{"enum":["synthetic","local"]},"size":{"enum":["tiny","small","medium","large",null]},"seed":{"type":["integer","null"]},
    "sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"rows":{"type":["integer","null"],"minimum":0,"maximum":20000}}},
  "plan":{"type":["object","null"]},
  "envelope":{"type":["object","null"],"additionalProperties":false,"required":["cpus","cpuset","smt_siblings","reduced","multicore"],
   "properties":{"cpus":{"type":"integer","minimum":1,"maximum":4},"cpuset":{"type":"array","items":{"type":"integer","minimum":0}},
    "smt_siblings":{"type":"array","items":{"type":"array","items":{"type":"integer","minimum":0}}},"reduced":{"type":"boolean"},"multicore":{"enum":["PASS","BLOCKED"]}}},
  "image_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "fixtures_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "evidence_digests":{"type":"object","maxProperties":4096,"propertyNames":{"minLength":1,"maxLength":512},"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "bench_profile_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "protocol_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$",
   "description":"FR3 (design Task 32): the sha256 of the protected protocol file of the run's project (null for a framework case or a project without a protocol); decide refuses a run whose digest differs from the current file (bench_evidence.protocol_problems)."},
  "run_record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "decision_digests":{"type":"object","maxProperties":8,"propertyNames":{"pattern":"^[a-z][a-z0-9-]{0,63}$"},"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "native":{"description":"Phase 2 Task 19 (FR6 N4): the native build of a run with a planned C row: built once per run, restored into every timing and memory job, and the three-version agreement check that ran with it before any timing. Absent for a run without a C row.","type":"object","additionalProperties":false,"required":["binaries","glib_sha256","kernel","agreement"],"properties":{"binaries":{"type":"object","minProperties":1,"maxProperties":32,"propertyNames":{"pattern":"^(?:[a-z][a-z0-9_-]{0,62}|lib[a-z][a-z0-9_]{0,62}\\.so)$"},"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"glib_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"compiler":{"type":["string","null"],"maxLength":200},"project_identity":{"type":["string","null"],"maxLength":128},"kernel":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["program","sha256"],"properties":{"program":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,62}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}]},"agreement":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["check","status"],"properties":{"check":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},"status":{"enum":["PASS","FAIL"]},"files":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":80}}}}]}}},
  "replay_of":{"description":"Task 20 (spec 13): the run id that this run replays (bench replay); absent for a run that is not a replay.","type":"string","pattern":"^[0-9a-f]{32}$"},
  "datasets":{"type":"object","maxProperties":64,"propertyNames":{"pattern":"^[a-z0-9:#-]{3,64}$"},
   "additionalProperties":{"type":"object","additionalProperties":false,"required":["kind","size","seed","sha256","rows"],
    "properties":{"kind":{"const":"synthetic"},"size":{"enum":["tiny","small","medium","large"]},"seed":{"type":"integer"},
     "sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"rows":{"type":"integer","minimum":0,"maximum":20000},
     "indices":{"type":"array","maxItems":20000,"items":{"type":"integer","minimum":0,"maximum":99999}}}}},
  "runtime":{"type":["object","null"]},
  "admission":{"type":"object","additionalProperties":false,"required":["lock_held_ns","active_at_handshake"],
   "properties":{"lock_held_ns":{"type":["integer","null"],"minimum":0},"active_at_handshake":{"type":"array","items":{"type":["integer","null"],"minimum":0}}}},
  "evidence":{"type":"object","additionalProperties":{"type":["string","array","null"]}},
  "status":{"enum":["VALID","INVALID_EXPERIMENT","BLOCKED","RUNNING"]},"reasons":{"type":"array","items":{"type":"string","maxLength":300}},
  "failure_reasons":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"}},
  "reference_evals":{"type":"object","minProperties":1,"maxProperties":8,"propertyNames":{"pattern":"^[a-z0-9-]{1,16}$"},"additionalProperties":{"type":"integer","minimum":0}},
  "reference_admit_excluded":{"type":"object","additionalProperties":false,"required":["row","brent","bump"],
   "properties":{"row":{"type":"integer","minimum":0},"brent":{"type":"integer","minimum":0},"bump":{"type":"integer","minimum":0}}},
  "reference_overhead":{"type":"object","additionalProperties":false,"required":["library_overhead_ns_per_row"],
   "properties":{"library_overhead_ns_per_row":{"type":"number","minimum":0}}},
  "accounting":{"type":"array","items":{"type":"object","additionalProperties":false,
   "required":["session","host_total_usec","window_usec","trial_sum_usec","trials","launcher_cgroup_inode","job_cgroup_inode","status"],
   "properties":{"session":{"type":"string"},"host_total_usec":{"type":["integer","null"]},"window_usec":{"type":["integer","null"]},
    "trial_sum_usec":{"type":"integer"},"trials":{"type":"integer","minimum":0},
    "launcher_cgroup_inode":{"type":["integer","null"]},"job_cgroup_inode":{"type":["integer","null"]},"status":{"enum":["PASS","FAIL"]}}}}
 }}
