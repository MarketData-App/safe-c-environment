{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"Amendment G3.3, G3.7 (Task 7), Amendment I7.2 and the H21 cell rule (Task A6), FR5 (ruling FR5-R1 item 1): the stored py-reference panel inputs of the synthetic large dataset for the panel models of the project's protected protocol file (FR3: `panel` models in order, mask 2^n - 1, digest form) under the project's cell rule (FR5: `panel.cell_rule`; the framework names no cell, category or column). Per row the row columns that the cell rule names (rows_columns, project names) and, per model, status, result flags, engine_evals and the grid test (grid_ok: true or false where every model status is OK and none of the listed flag bits 1, 2, 4 is set, flag bit 8 rows included; null elsewhere). The stored copy of the cell rule (cell_rule: role columns, level ratios, grid test settings, report entries; FR5A-01: the framework names no grid value). Per cell: its definition (name, category, band, targets), the evaluated candidate order up to and including the selected row (each row with its level and d), every rejected row of the pre-flight check (H21.7) with its reason, the status difference and the sha256 and project-relative path of the pre-flight record, and the selected row with its level. tools/bench_panel.check also requires equal column lengths, the own sha256, the stored cell rule and cell definitions equal to the project protocol, the row columns of that rule and the stored orders, rejections and indices equal to the one selection rule applied to the stored values. FR5 migration: schema_version 3 documents (fixed framework cells) are refused; a project rebuilds its reference with bench panel after it declares its cell rule.",
 "required":["schema_version","case","dataset","seed","rows","generator_sha256","models","mask","reference_digest_form","reference_sha256","cell_rule","cells","indices","rows_columns","per_model","sha256"],
 "$defs":{
  "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "status":{"type":"string","pattern":"^[A-Z][A-Z_]{1,30}$","description":"a row status of the project's reference; OK is the only status the selection rule admits"},
  "model_name":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},
  "column":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,31}$"},
  "finite":{"type":"number","minimum":-1e300,"maximum":1e300},
  "level":{"enum":[0,1,2]},
  "model":{"type":"object","additionalProperties":false,"required":["status","flags","engine_evals","grid_ok"],
   "properties":{
    "status":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/status"}},
    "flags":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0,"maximum":127}},
    "engine_evals":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0}},
    "grid_ok":{"type":"array","minItems":1,"items":{"type":["boolean","null"]}}}},
  "rejection":{"type":"object","additionalProperties":false,
   "required":["row","reason","variant","workers","model","status","reference_status","band_difference","preflight_sha256","preflight_path"],
   "properties":{"row":{"type":"integer","minimum":0},"reason":{"const":"preflight-status-difference"},
    "variant":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,40}$"},"workers":{"oneOf":[{"const":"direct"},{"type":"integer","minimum":1,"maximum":64}]},
    "model":{"$ref":"#/$defs/model_name"},"status":{"$ref":"#/$defs/status"},"reference_status":{"$ref":"#/$defs/status"},
    "band_difference":{"type":"boolean"},"preflight_sha256":{"$ref":"#/$defs/sha"},
    "preflight_path":{"type":"string","pattern":"^cases/panel-preflight/[0-9a-f]{64}\\.json$"}}},
  "cell_rule":{"type":"object","additionalProperties":false,"required":["category","position","scale","level_ratios","grid","report"],
   "properties":{
    "category":{"type":"object","additionalProperties":false,"required":["column","labels"],
     "properties":{"column":{"$ref":"#/$defs/column"},
      "labels":{"type":"object","minProperties":1,"maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9-]{0,15}$"},"additionalProperties":{"type":"integer","minimum":0,"maximum":255}}}},
    "position":{"$ref":"#/$defs/column"},
    "scale":{"$ref":"#/$defs/column"},
    "level_ratios":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","exclusiveMinimum":1,"maximum":1e6}},
    "grid":{"type":"object","additionalProperties":false,"required":["upper","points"],
     "properties":{"upper":{"type":"number","exclusiveMinimum":0,"maximum":1e6},"points":{"type":"integer","minimum":2,"maximum":4096}}},
    "report":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["name","column"],
     "properties":{"name":{"$ref":"#/$defs/column"},"column":{"$ref":"#/$defs/column"},"factor":{"type":"number","exclusiveMinimum":0,"maximum":1e6}}}}}},
  "cell":{"type":"object","additionalProperties":false,"required":["name","category","band","position_target","scale_target","order","rejected","selected"],
   "properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},"category":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,15}$"},
    "band":{"type":"object","additionalProperties":false,"required":["op","bound"],"properties":{"op":{"enum":["gt","lt","abs_le"]},"bound":{"$ref":"#/$defs/finite"}}},
    "position_target":{"$ref":"#/$defs/finite"},"scale_target":{"type":"number","exclusiveMinimum":0,"maximum":1e300},
    "order":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["row","level","d"],
     "properties":{"row":{"type":"integer","minimum":0},"level":{"$ref":"#/$defs/level"},"d":{"type":"number","minimum":0}}}},
    "rejected":{"type":"array","items":{"$ref":"#/$defs/rejection"}},
    "selected":{"type":"object","additionalProperties":false,"required":["row","level"],
     "properties":{"row":{"type":"integer","minimum":0},"level":{"$ref":"#/$defs/level"}}}}}},
 "properties":{
  "schema_version":{"const":4},
  "case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "dataset":{"const":"synthetic:large"},
  "seed":{"type":"integer","minimum":0},
  "rows":{"type":"integer","minimum":1,"maximum":20000},
  "generator_sha256":{"$ref":"#/$defs/sha","description":"sha256 of the generated synthetic large dataset (the recorded generator output hash, spec 9; the dataset sha256 of the job)"},
  "models":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/model_name"}},
  "mask":{"type":"integer","minimum":1,"maximum":255,"description":"2^n - 1 over the models in order (tools/bench_panel.check)"},
  "reference_digest_form":{"type":"string","pattern":"^[a-z0-9-]{3,32}$"},
  "reference_sha256":{"$ref":"#/$defs/sha"},
  "cell_rule":{"$ref":"#/$defs/cell_rule"},
  "cells":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/cell"}},
  "indices":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"integer","minimum":0}},
  "rows_columns":{"type":"object","minProperties":3,"maxProperties":8,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,31}$"},
   "additionalProperties":{"type":"array","minItems":1,"items":{"type":["number","null"]}},
   "description":"one column per row column of the cell rule (tools/bench_panel.check: the category column holds rule label values, the scale column finite numbers > 0, every other column finite numbers or null)"},
  "per_model":{"type":"object","minProperties":1,"maxProperties":8,"propertyNames":{"$ref":"#/$defs/model_name"},"additionalProperties":{"$ref":"#/$defs/model"},
   "description":"one entry per model of `models` (tools/bench_panel.check)"},
  "sha256":{"$ref":"#/$defs/sha"}}}
