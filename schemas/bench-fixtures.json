{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"The protected framework fixtures (safety/performance-fixtures.json): the B and pipeline case inventories and the synthetic decision-engine cases. FR3 (FS1 F5): project oracle data, generator digests, calibration and model tables live in the project's protected protocol file (schemas/bench-protocol.json), never here.",
 "required":["schema_version","b_cases","pipeline_subcases","decision_cases"],
 "properties":{
  "schema_version":{"const":1},
  "b_cases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","name","phase","property"],
   "properties":{"id":{"type":"string","pattern":"^B(0[1-9]|1[0-8])$"},"name":{"type":"string","pattern":"^[a-z0-9-]{3,60}$"},"phase":{"enum":[1,2,3]},"property":{"type":"string","maxLength":300}}}},
  "pipeline_subcases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["parent","name","variants"],
   "properties":{"parent":{"enum":["P01","P02","P04","P07","P10","P11","P15","P16"]},"name":{"type":"string","pattern":"^bench-[a-z0-9-]{3,60}$"},
    "variants":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9-]{3,60}$"}}}}},
  "decision_cases":{"type":"object","additionalProperties":false,"required":["policy","cases","unit_cases","unit_policy"],
   "description":"Task 14 (spec 10, Amendment H2-H4, B14): the filled engine test policy and the synthetic decision cases (explicit rows; no generator). Task 15 (G9.3, G12 B14, I12 B14, I15.4, H21.4): unit_cases for a unit-threshold policy; a case names a qualification truth-table row instead of repeating its inputs. FR3: unit_policy is the synthetic engine test unit-threshold policy (selectors m1..m5); a project's real unit-threshold policy lives in its protocol file.",
   "$defs":{"num":{"type":"number","exclusiveMinimum":0},"num_or_null":{"type":["number","null"],"exclusiveMinimum":0},
    "outcome":{"enum":["INVALID_EXPERIMENT","INCONCLUSIVE","KEEP_PYTHON","C_CANDIDATE_FOR_REVIEW","OPTIMIZE_PYTHON_FIRST","USE_EXISTING_PYTHON_LIBRARY","CONSIDER_PYTHON_CONCURRENCY"]},
    "text":{"type":"string","minLength":1,"maxLength":300},
    "unit":{"type":"string","pattern":"^[a-z0-9-]{1,16}/(full-dataset|single-record)$"},
    "workers":{"oneOf":[{"const":"direct"},{"type":"integer","minimum":1,"maximum":64}]}},
   "properties":{
    "policy":{"type":"object","additionalProperties":false,
     "required":["name","state","demonstration_only","objective","metric","modes","points","relative_threshold","min_abs_saving_ns_per_call",
                 "absolute_target_ns_per_unit","target_margin","pool_cpu_guard","limits","sizes","concurrency"],
     "properties":{"name":{"const":"test-filled"},"state":{"const":"approved"},"demonstration_only":{"const":false},
      "objective":{"$ref":"#/properties/decision_cases/$defs/text"},"metric":{"enum":["wall_ns_per_unit","cpu_ns_per_unit"]},
      "modes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["warm","cold"]}},
      "points":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["baseline","full-dataset"]}},
      "relative_threshold":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
      "min_abs_saving_ns_per_call":{"type":"number","minimum":0},
      "absolute_target_ns_per_unit":{"$ref":"#/properties/decision_cases/$defs/num_or_null"},
      "target_margin":{"type":["number","null"],"minimum":0},"pool_cpu_guard":{"type":["number","null"],"minimum":0},
      "limits":{"type":"object","additionalProperties":false,"required":["cpu_regression","latency_regression","memory_regression"],
       "properties":{"cpu_regression":{"type":["number","null"],"minimum":0},"latency_regression":{"type":["number","null"],"minimum":0},
        "memory_regression":{"type":["number","null"],"minimum":0}}},
      "sizes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["tiny","small","medium","large"]}},
      "concurrency":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":64}}}},
    "unit_policy":{"type":"object","additionalProperties":false,
     "description":"The engine test unit-threshold policy: the schemas/bench-protocol.json unit_threshold_policy fields plus name and library_report; the statistical constants are pinned as there.",
     "required":["name","state","demonstration_only","kind","source","case","metric","verdict_mode","reported_modes","threshold_ns_per_request","units",
                 "python_languages","c_languages","safe_routes","less_safe_routes","panel_statistic","primary_blocks","interval_method",
                 "alpha_one_sided","multiplicity","extension_blocks","extension_trigger","extension_window","c_project_check","pool_cpu_guard","limits","library_report"],
     "properties":{"name":{"const":"test-unit-threshold"},"state":{"const":"approved"},"demonstration_only":{"const":false},"kind":{"const":"unit-threshold"},
      "source":{"$ref":"#/properties/decision_cases/$defs/text"},"case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
      "metric":{"const":"wall_ns_per_request"},"verdict_mode":{"const":"warm"},"reported_modes":{"const":["warm","cold"]},
      "threshold_ns_per_request":{"type":"integer","minimum":1},
      "units":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"$ref":"#/properties/decision_cases/$defs/unit"}},
      "python_languages":{"const":["python","python-library"]},"c_languages":{"const":["c"]},"safe_routes":{"const":["stdio","shm"]},"less_safe_routes":{"const":["inproc"]},
      "panel_statistic":{"const":"max"},"primary_blocks":{"const":12},"interval_method":{"const":"order-statistic"},"alpha_one_sided":{"const":[0.025,0.0125]},
      "multiplicity":{"const":"bonferroni"},"extension_blocks":{"const":12},"extension_trigger":{"const":"python-near-threshold"},"extension_window":{"const":"separate-lock-window"},
      "c_project_check":{"const":{"accept_exit":[0,3],"exit_3_requires":"local-framework-qualification-g9.4","exit_3_label":"framework qualified locally, not published"}},
      "pool_cpu_guard":{"type":"null"},
      "limits":{"type":"object","additionalProperties":false,"required":["cpu_regression","latency_regression","memory_regression"],
       "properties":{"cpu_regression":{"type":"null"},"latency_regression":{"type":"null"},"memory_regression":{"type":"null"}}},
      "library_report":{"type":"object","additionalProperties":false,"required":["selectors","label"],
       "properties":{"selectors":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"}},
        "label":{"type":"string","minLength":1,"maxLength":120}}}}},
    "cases":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,
     "required":["name","expect","status","native_gates","opportunity","blocked","rows"],
     "properties":{"name":{"type":"string","pattern":"^[a-z0-9-]{3,60}$"},
      "expect":{"type":"object","additionalProperties":false,"required":["outcome","rule"],
       "properties":{"outcome":{"$ref":"#/properties/decision_cases/$defs/outcome"},"rule":{"type":"integer","minimum":1,"maximum":8}}},
      "status":{"enum":["VALID","INVALID","FAIL","BLOCKED"]},"native_gates":{"enum":["PASS","PASS_UNQUALIFIED_FRAMEWORK","FAIL","BLOCKED",null]},
      "policy_modes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["warm","cold"]}},
      "threaded_correctness":{"type":["boolean","null"]},"envelope_ok":{"type":["boolean","null"]},"crossover_measured":{"type":"boolean"},
      "policy_bound":{"type":"boolean"},
      "opportunity":{"type":"object","additionalProperties":false,"required":["approval","python_options","operational_costs"],
       "properties":{"approval":{"type":"object","additionalProperties":false,"required":["state"],
         "properties":{"state":{"enum":["PENDING","APPROVED"]},"baseline_variant":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"}}},
        "python_options":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["name","state"],
         "properties":{"name":{"$ref":"#/properties/decision_cases/$defs/text"},"state":{"enum":["measured","proposed"]}}}},
        "operational_costs":{"type":"object","additionalProperties":false,
         "required":["transport","deployment_artifacts","observability","failure_handling","retries_idempotency","ownership_abi","native_boundary_maintenance"],
         "properties":{"transport":{"$ref":"#/properties/decision_cases/$defs/text"},"deployment_artifacts":{"$ref":"#/properties/decision_cases/$defs/text"},
          "observability":{"$ref":"#/properties/decision_cases/$defs/text"},"failure_handling":{"$ref":"#/properties/decision_cases/$defs/text"},
          "retries_idempotency":{"$ref":"#/properties/decision_cases/$defs/text"},"ownership_abi":{"$ref":"#/properties/decision_cases/$defs/text"},
          "native_boundary_maintenance":{"$ref":"#/properties/decision_cases/$defs/text"}}}}},
      "blocked":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["variant","workers","route","reason"],
       "properties":{"variant":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},"workers":{"$ref":"#/properties/decision_cases/$defs/workers"},
        "route":{"enum":["stdio","shm","inproc",null]},"reason":{"$ref":"#/properties/decision_cases/$defs/text"}}}},
      "rows":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","additionalProperties":false,
       "required":["point","mode","variant","workers","route","language","eligible","wall","cpu","spread","peak","scope"],
       "properties":{"point":{"enum":["baseline","full-dataset"]},"mode":{"enum":["warm","cold"]},
        "variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},
        "workers":{"$ref":"#/properties/decision_cases/$defs/workers"},"route":{"enum":["stdio","shm","inproc",null]},
        "language":{"enum":["python","python-library","c"]},"eligible":{"type":"boolean"},
        "wall":{"$ref":"#/properties/decision_cases/$defs/num"},"cpu":{"$ref":"#/properties/decision_cases/$defs/num"},
        "spread":{"type":"number","minimum":0,"maximum":0.5},"peak":{"type":["integer","null"],"minimum":1},"scope":{"const":"caller"}}}}}}},
    "unit_cases":{"type":"array","minItems":1,"maxItems":40,"items":{"type":"object","additionalProperties":false,"required":["name","unit","expect","rows"],
     "properties":{"name":{"type":"string","pattern":"^[a-z0-9-]{3,60}$"},
      "unit":{"$ref":"#/properties/decision_cases/$defs/unit"},
      "qualification_row":{"type":"string","pattern":"^Q(0[1-9]|1[0-9]|2[0-2])$"},
      "primary_blocks":{"type":"integer","minimum":1,"maximum":12},
      "expect":{"type":"object","additionalProperties":false,"required":["verdict","reason","verdict_safe_route"],
       "properties":{"verdict":{"enum":["KEEP_PYTHON","PREFER_C","INCONCLUSIVE","INVALID_EXPERIMENT"]},
        "reason":{"enum":["python-under-threshold","python-near-threshold","python-at-threshold","python-evidence-missing","py-reference-not-measured",
                          "c-reliably-faster","c-not-eligible","c-evidence-missing","c-not-reliably-faster","ineligible-row","run-invalid","bound-unattainable"]},
        "verdict_safe_route":{"enum":["KEEP_PYTHON","PREFER_C","INCONCLUSIVE","INVALID_EXPERIMENT"]},
        "failed_conditions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["framework-unqualified","project-gates-failed","project-check-blocked","opportunity-not-approved"]}}}},
      "evidence":{"type":"object","additionalProperties":false,
       "properties":{"status":{"enum":["VALID","INVALID_EXPERIMENT"]},"coverage_ok":{"type":"boolean"},"opportunity_state":{"enum":["PENDING","APPROVED"]},
        "looks":{"type":"object","additionalProperties":{"enum":[1,2]}},
        "window_mismatch":{"type":"array","maxItems":10,"items":{"$ref":"#/properties/decision_cases/$defs/unit"}},
        "extension_not_run":{"type":"array","maxItems":10,"items":{"$ref":"#/properties/decision_cases/$defs/unit"}},
        "blocked_other":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["unit","label","reason"],
         "properties":{"unit":{"type":"string"},"label":{"type":"string","maxLength":200},"reason":{"$ref":"#/properties/decision_cases/$defs/text"}}}},
        "envelope_not_planned":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["unit","label"],
         "properties":{"unit":{"type":"string"},"label":{"type":"string","maxLength":200}}}},
        "reference_evals":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},
        "panel_evals":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"type":"integer","minimum":1}}}}},
      "rows":{"type":"array","minItems":1,"maxItems":40,"items":{"type":"object","additionalProperties":false,"required":["variant","workers","route","language","wall"],
       "properties":{"unit":{"$ref":"#/properties/decision_cases/$defs/unit"},"mode":{"enum":["warm","cold"]},
        "variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},
        "workers":{"$ref":"#/properties/decision_cases/$defs/workers"},"route":{"enum":["stdio","shm","inproc",null]},
        "language":{"enum":["python","python-library","c"]},"eligible":{"type":"boolean"},"planned":{"type":"boolean"},
        "wall":{"oneOf":[{"$ref":"#/properties/decision_cases/$defs/num"},
                         {"type":"array","minItems":1,"maxItems":24,"items":{"$ref":"#/properties/decision_cases/$defs/num"}}]},
        "blocks":{"type":"integer","minimum":1,"maximum":24},"record_wall":{"$ref":"#/properties/decision_cases/$defs/num"},
        "detail":{"enum":["panel-status"]}}}}}}}}}
 }}
