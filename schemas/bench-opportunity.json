{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["schema_version","case_id","operation","sizes","frequency","target","footprint","breakdown","python_options","approval"],
 "$defs":{"measured":{"oneOf":[{"type":"object","additionalProperties":false,"required":["value","run_id","label"],
    "properties":{"value":{"type":"number"},"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"label":{"enum":["smoke-exploratory","decision"]}}},
   {"type":"object","additionalProperties":false,"required":["value","reason"],"properties":{"value":{"type":"null"},"reason":{"type":"string","maxLength":200}}}]},
  "share":{"type":"object","additionalProperties":false,"required":["share","uncertainty"],
   "properties":{"share":{"type":["number","null"],"minimum":0,"maximum":1},"uncertainty":{"type":"string","maxLength":200}}},
  "cost":{"type":"string","minLength":1,"maxLength":300,"pattern":"\\S"}},
 "properties":{
  "schema_version":{"const":1},"case_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "operation":{"type":"string","maxLength":300},
  "sizes":{"type":"object","additionalProperties":false,"required":["records_per_call"],"properties":{"records_per_call":{"type":["integer","null"],"minimum":1}}},
  "frequency":{"type":"string","maxLength":100},
  "target":{"type":"object","additionalProperties":false,"required":["kind","value","unit"],
   "properties":{"kind":{"enum":["none","latency","throughput","cpu"]},"value":{"type":["number","null"]},"unit":{"type":["string","null"],"maxLength":40}}},
  "footprint":{"type":"object","additionalProperties":false,"required":["cpu_ns_per_unit","wall_ns_per_unit","ready_state_bytes","group_peak_bytes"],
   "properties":{"cpu_ns_per_unit":{"$ref":"#/$defs/measured"},"wall_ns_per_unit":{"$ref":"#/$defs/measured"},"ready_state_bytes":{"$ref":"#/$defs/measured"},"group_peak_bytes":{"$ref":"#/$defs/measured"}}},
  "breakdown":{"type":"object","additionalProperties":false,"required":["computation","allocation","serialization","database","io_wait","lock_contention","queueing"],
   "properties":{"computation":{"$ref":"#/$defs/share"},"allocation":{"$ref":"#/$defs/share"},"serialization":{"$ref":"#/$defs/share"},"database":{"$ref":"#/$defs/share"},
    "io_wait":{"$ref":"#/$defs/share"},"lock_contention":{"$ref":"#/$defs/share"},"queueing":{"$ref":"#/$defs/share"}}},
  "python_options":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","state","run_id"],
   "properties":{"name":{"type":"string","maxLength":120},"state":{"enum":["measured","proposed"]},"run_id":{"type":["string","null"],"pattern":"^[0-9a-f]{32}$"}}}},
  "approval":{"type":"object","additionalProperties":false,"required":["state","reference"],
   "properties":{"state":{"enum":["PENDING","APPROVED"]},"reference":{"type":"string","maxLength":300},
    "baseline_variant":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$","description":"Amendment H4 item 8: the approved baseline variant; bench_model.check_baseline_variant requires a variant id of the case."}}},
  "operational_costs":{"type":"object","additionalProperties":false,
   "description":"Amendment H4 item 7: exactly the seven integration and operational cost entries, each non-empty.",
   "required":["transport","deployment_artifacts","observability","failure_handling","retries_idempotency","ownership_abi","native_boundary_maintenance"],
   "properties":{"transport":{"$ref":"#/$defs/cost"},"deployment_artifacts":{"$ref":"#/$defs/cost"},"observability":{"$ref":"#/$defs/cost"},
    "failure_handling":{"$ref":"#/$defs/cost"},"retries_idempotency":{"$ref":"#/$defs/cost"},"ownership_abi":{"$ref":"#/$defs/cost"},
    "native_boundary_maintenance":{"$ref":"#/$defs/cost"}}}
 }}
