{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "description":"The closed aggregate of a local (owner-fixture) run: the framework envelope only (FR3, design Task 32). The case block `summary` is project data: the host validates it with the aggregate schema of the project's protected protocol file (bench_privacy.accept_aggregate) and refuses a quantile over fewer than 5 rows anywhere in it; null when the run has no summary (then the status is never VALID). Exception types are framework names or names that the protocol lists in local_exceptions (host check).",
 "required":["schema_version","run_id","case","dataset_sha256","rows","summary","timings","counters","exceptions","output_digests","status"],
 "$defs":{"num":{"type":["number","null"]},"cnt":{"type":"integer","minimum":0},
  "dist":{"type":"object","additionalProperties":false,"required":["n","median","iqr","min","max"],
   "properties":{"n":{"$ref":"#/$defs/cnt"},"median":{"$ref":"#/$defs/num"},"iqr":{"$ref":"#/$defs/num"},"min":{"$ref":"#/$defs/num"},"max":{"$ref":"#/$defs/num"}}}},
 "properties":{
  "schema_version":{"const":2},"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"case":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "dataset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"rows":{"type":"integer","minimum":0,"maximum":20000},
  "summary":{"type":["object","null"],"maxProperties":32},
  "timings":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["point","scope","mode","variant","workers","tier","trials","eligible","wall_ns_per_unit","cpu_ns_per_unit"],
   "properties":{"point":{"enum":["baseline","full-dataset","language-only","crossover-tiny","crossover-small","smoke-caller","smoke-kernel"]},"scope":{"enum":["kernel","caller"]},
    "mode":{"enum":["warm","cold","direct"]},"variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},"workers":{"enum":["direct",1,2,4]},
    "tier":{"enum":["tiny","small","medium","large"]},"trials":{"$ref":"#/$defs/cnt"},"eligible":{"type":"boolean"},
    "wall_ns_per_unit":{"$ref":"#/$defs/dist"},"cpu_ns_per_unit":{"$ref":"#/$defs/dist"}}}},
  "counters":{"type":"object","additionalProperties":false,"required":["cpu_usage_usec","memory_peak_bytes"],
   "properties":{"cpu_usage_usec":{"type":["integer","null"],"minimum":0},"memory_peak_bytes":{"type":["integer","null"],"minimum":0}}},
  "exceptions":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["type","row_index"],
   "properties":{"type":{"type":"string","pattern":"^[A-Z][A-Za-z0-9]{1,40}$"},"row_index":{"type":["integer","null"],"minimum":0,"maximum":19999}}}},
  "output_digests":{"type":"object","additionalProperties":false,"required":["result_sha256","reference_sha256"],
   "properties":{"result_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"reference_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
  "status":{"enum":["VALID","INVALID_EXPERIMENT","BLOCKED"]}
 },
 "allOf":[{"if":{"properties":{"summary":{"type":"null"}}},"then":{"properties":{"status":{"not":{"const":"VALID"}}}}}]}
