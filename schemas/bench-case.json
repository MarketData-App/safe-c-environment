{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
 "required":["schema_version","case_id","version","kind","adapter","description","work_unit","parameters","variants","scopes","sizes","points","opportunity_record"],
 "properties":{
  "schema_version":{"const":1},
  "case_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,40}$"},
  "version":{"type":"integer","minimum":1},
  "kind":{"enum":["function","service","offline-job"]},
  "adapter":{"type":"string","pattern":"^[a-z_][a-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"},
  "description":{"type":"string","maxLength":400},
  "work_unit":{"type":"string","maxLength":200},
  "parameters":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["value","label"],
   "properties":{"value":{"type":["number","object"],"description":"a number; an object only for a structured protocol parameter (Amendment I2.2: a project's structured scheme parameter)"},"label":{"enum":["assumption","declared","protocol"]},"note":{"type":"string","maxLength":300}}}},
  "variants":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","language","workers","status"],
   "properties":{"id":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},"language":{"enum":["python","python-library","c"]},
    "workers":{"type":"array","minItems":1,"items":{"enum":["direct",1,2,4]}},
    "status":{"enum":["implemented","same-as-reference","not-applicable","planned-phase-2"]},"reason":{"type":"string","maxLength":300},"routes":{"description":"Phase 2 Task 19 (FR6 N4):the data transfer routes of a C variant (a subset; default [\"stdio\"]).","type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["stdio","shm","inproc"]}}}}},
  "scopes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["kernel","caller","capacity"]}},
  "sizes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["tiny","small","medium","large"]}},
  "points":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","scope","size","modes","variants","class"],
   "properties":{"name":{"type":"string","pattern":"^[a-z-]{3,40}$"},"scope":{"enum":["kernel","caller","capacity"]},"size":{"enum":["tiny","small","medium","large"]},
    "modes":{"type":"array","minItems":1,"items":{"enum":["warm","cold","direct"]}},"variants":{"type":"array","minItems":1,"items":{"type":"string"}},
    "class":{"enum":["primary","secondary","exploratory"]},
    "selector":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},"panel":{"type":"array","minItems":1,"maxItems":6,"items":{"type":"integer","minimum":0}},
    "unit":{"type":"string","pattern":"^[a-z0-9-]{1,16}/[a-z-]{3,24}$"},"dataset_ref":{"type":"string","pattern":"^[a-z0-9:#-]{3,64}$"},"routes":{"description":"Phase 2 Task 19 (FR6 N4):the routes of the C rows of this point (a subset of each C variant's routes).","type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["stdio","shm","inproc"]}}}}},
  "selectors":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"},"contains":{"const":"all"}},
  "call_deadline":{"type":"object","additionalProperties":false,"required":["selectors","reason","factor","floor_seconds"],
   "properties":{"selectors":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"}},
    "reason":{"type":"string","pattern":"^[a-z0-9-]{1,32}$"},"factor":{"type":"number","minimum":1},"floor_seconds":{"type":"number","exclusiveMinimum":0}}},
  "call_deadlines":{"type":"array","maxItems":8,"items":{"$ref":"#/properties/call_deadline"},
   "description":"Amendment I9.1 (Task A2): further call-deadline entries of the closed call_deadline shape; bench_deadline.entries joins them after call_deadline, and bench_model.check_call_deadlines refuses overlapping selectors."},
  "capacity":{"description":"Task 22 (Amendment H6): the closed-loop capacity configurations of the capacity scope (exploratory; never decide).",
   "type":"object","additionalProperties":false,"required":["tier","clients","requests_per_client","configurations"],
   "properties":{"tier":{"enum":["tiny","small","medium","large"]},"clients":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":[1,2,4]}},
    "requests_per_client":{"type":"integer","minimum":1,"maximum":64},
    "configurations":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["name","variant"],
     "properties":{"name":{"enum":["serial-workers","threaded-worker","python-pool"]},"variant":{"enum":["py-reference","py-optimized","py-library","py-threads","py-processes","c-serial","c-threads"]},
      "route":{"type":"string","pattern":"^[a-z0-9-]{1,16}$"}},
     "allOf":[{"description":"T22-APP-03: serial-workers runs a direct variant; threaded-worker and python-pool run a pooled variant.",
       "if":{"required":["name"],"properties":{"name":{"const":"serial-workers"}}},"then":{"properties":{"variant":{"enum":["py-reference","py-optimized","py-library","c-serial"]}}}},
      {"if":{"required":["name"],"properties":{"name":{"enum":["threaded-worker","python-pool"]}}},"then":{"properties":{"variant":{"enum":["py-threads","py-processes","c-threads"]}}}}]}}}},
  "opportunity_record":{"type":["string","null"],"pattern":"^benchmarks/(performance|project)/cases/[a-z0-9-]+\\.opportunity\\.json$"}
 }}
