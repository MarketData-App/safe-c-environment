{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary",
    "extra",
    "generated_value",
    "define_value"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "primary": {
      "enum": [
        "candidate.c",
        "renamed.c",
        "path with space/\u00b5.c"
      ]
    },
    "extra": {
      "type": "boolean"
    },
    "generated_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "define_value": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
